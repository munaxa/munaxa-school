# ============================================================================
# Munaxa — Root environment example (shared / docker-compose)
# Copy to `.env` and fill values. NEVER commit real secrets.
# App-specific examples live in apps/api/.env.example and apps/admin/.env.example
# ============================================================================

# Node
NODE_ENV=development

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=munaxa
POSTGRES_PASSWORD=munaxa_local_dev
POSTGRES_DB=munaxa
POSTGRES_PORT=5432

# --- Redis (docker-compose) ---
REDIS_PORT=6379

# --- LocalStack (S3 emulation, local only) ---
LOCALSTACK_PORT=4566

# --- Mailhog (email capture, local only) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
