# ============================================================================
# Munaxa Admin Portal — environment example. Copy to .env.local.
# NEXT_PUBLIC_* values are exposed to the browser by design (no secrets there).
# ============================================================================

# API base URL — keep this SAME-ORIGIN (relative) so the httpOnly session cookies are first-party.
# The admin reverse-proxies /api/v1/* to API_PROXY_TARGET below.
NEXT_PUBLIC_API_URL=/api/v1

# Where the admin server proxies /api/v1/* to (the real NestJS API origin). Server-only.
API_PROXY_TARGET=http://localhost:4000

# Environment label
NEXT_PUBLIC_ENV=development

# --- Firebase Auth (client SDK; Phase 3) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- PostHog (product analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Server-only token for source map upload in CI (never commit):
SENTRY_AUTH_TOKEN=
