{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+/node_modules/.+\\.js$": [
      "ts-jest",
      {
        "isolatedModules": true,
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "target": "es2022"
        }
      }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@school/domain$": "<rootDir>/../../../packages/domain/src/index.ts",
    "^@school/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts",
    "^@school/utils$": "<rootDir>/../../../packages/utils/src/index.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "maxWorkers": 1,
  "testTimeout": 60000,
  "transformIgnorePatterns": ["/node_modules/(?!(\\.pnpm/@munaxa\\+|@munaxa/))"]
}
