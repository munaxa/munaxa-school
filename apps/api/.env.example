# ============================================================================
# Munaxa API — environment example. Copy to .env. NEVER commit real secrets.
# ============================================================================

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=v1

# --- Database (Prisma / PostgreSQL) ---
# Runtime: restricted, NON-superuser, NOBYPASSRLS role so Row-Level Security is enforced.
# MUST be the `munaxa_app` role — using `postgres` here silently bypasses RLS.
DATABASE_URL=postgresql://munaxa_app.<project-ref>:APP_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?schema=public
# Migrations/introspection ONLY: privileged schema owner (used by `prisma migrate`). Not for runtime.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:OWNER_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?schema=public

# --- Redis (cache, rate limiting, queues) ---
REDIS_URL=redis://localhost:6379

# --- CORS (comma-separated origins) ---
# The Platform Console is served by the SAME admin app, so a single admin origin covers both the
# school portal and the console. In production list your admin host, e.g. https://admin.munaxa.com
CORS_ORIGINS=http://localhost:3000

# --- Platform Console bootstrap (used by `pnpm --filter @school/api db:seed:platform-owner`) ---
# Creates the first Munaxa-employee login. Run once after migrations; then sign in at the admin
# /login (leave the school field blank). PLATFORM_OWNER_ROLE defaults to PlatformOwner.
PLATFORM_OWNER_EMAIL=owner@munaxa.com
PLATFORM_OWNER_PASSWORD=
# PLATFORM_OWNER_ROLE=PlatformOwner

# --- JWT (issued by the API; Phase 3) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=2592000

# --- Firebase Admin (Auth verification; Phase 3) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AWS S3 (file storage) ---
AWS_REGION=eu-central-1
AWS_S3_BUCKET=munaxa-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For LocalStack in local dev:
AWS_S3_ENDPOINT=http://localhost:4566

# --- Email (Resend) ---
# Email is a no-op until RESEND_API_KEY is set (that is when "Notify parent" reports
# "mail service unavailable"). The FROM addresses must use a domain VERIFIED in your
# Resend account, or Resend rejects the send (also surfaced as "mail service unavailable").
RESEND_API_KEY=
EMAIL_FROM=Munaxa <no-reply@mail.munaxa.com>
# Sender for security/account emails (temporary passwords).
EMAIL_FROM_ADMIN=Munaxa <admin@mail.munaxa.com>
# Sender for finance/payment emails (parent settlement notifications). Used as the fallback when
# a school has no slug/tenant record; normally each school gets its own auto-derived address below.
EMAIL_FROM_FINANCE=Munaxa <payments@mail.munaxa.com>
# Verified Resend domain used to auto-derive each school's own parent-notification sender as
# "<School Name> <<tenant-slug>@<domain>>" (a school can override it in Notification Settings).
EMAIL_SENDER_DOMAIN=mail.munaxa.com

# --- Security ---
# '1' enables the HIBP k-anonymity breach check on password set/change (fail-open; recommended in production).
PASSWORD_BREACH_CHECK=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# E-invoicing (Phase 16) — secrets master key (32 bytes, base64), required only when a
# tenant enables e-invoicing. Generate: openssl rand -base64 32
EINVOICE_MASTER_KEY=
# Set to 0 to disable the submission worker (tests)
EINVOICE_WORKER=

# SMS gateway for late-payment reminders (no-op until both are set)
SMS_PROVIDER=
SMS_API_KEY=
