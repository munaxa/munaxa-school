{
  "name": "munaxa-school",
  "version": "0.1.0",
  "private": true,
  "description": "Munaxa School \u2014 the School Operating System. An independent product repository: API, admin, mobile, demo, database and infrastructure. Consumes the shared design system from @munaxa/*.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "turbo run validate",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "prisma:generate": "pnpm --filter @school/api prisma:generate",
    "prisma:migrate": "pnpm --filter @school/api prisma:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{munaxademo,scripts,infra}/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core",
      "sharp",
      "core-js",
      "protobufjs",
      "@sentry/cli",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": "^2.5.0",
      "deepmerge-ts": "^8.0.2",
      "postcss": "^8.5.25",
      "vite": "^7.3.7",
      "js-yaml@5.2.1": "^5.4.1",
      "glob@10.3.3": "^10.5.0"
    }
  }
}
