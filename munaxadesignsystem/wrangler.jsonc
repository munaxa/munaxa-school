{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "designsystem",
  "compatibility_date": "2026-06-18",
  // Static-assets Worker: the design system is a Vite SPA. Cloudflare serves the
  // built client directly and handles client-side routing natively, so the
  // Express server in server/index.ts (static serving + SPA fallback) is not
  // needed on Cloudflare. Build with `pnpm cf:build` (outputs dist/public).
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
  },
}
