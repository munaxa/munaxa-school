{
  "name": "@school/brand",
  "version": "0.1.0",
  "private": true,
  "description": "Munaxa School's wordmark set as text, for running copy. The logo itself is the approved artwork shipped by @munaxa/platform and rendered by ProductLogo.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "@types/react": "^19.0.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3"
  }
}
