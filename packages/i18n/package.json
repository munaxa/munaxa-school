{
  "name": "@school/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./en": "./src/locales/en.json",
    "./ar": "./src/locales/ar.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.cache/tsc-typecheck.tsbuildinfo",
    "lint": "eslint src",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "devDependencies": {
    "@axa/config-eslint": "workspace:*",
    "@axa/config-typescript": "workspace:*",
    "@school/domain": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3"
  }
}
