{
  "name": "munaxademo",
  "version": "1.0.0",
  "private": true,
  "description": "Munaxa Demo — a database-free live demonstration of the Munaxa School OS. Workspace member consuming the shared @axa/platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start -p 4100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf:deps": "pnpm turbo run build --filter=@axa/platform",
    "cf:build": "pnpm run cf:deps && opennextjs-cloudflare build && node ../scripts/cf-emit-root-wrangler.mjs",
    "cf:preview": "pnpm run cf:build && wrangler dev",
    "cf:deploy": "pnpm run cf:build && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@axa/platform": "workspace:*",
    "next": "15.5.19",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@axa/config-typescript": "workspace:*",
    "@next/eslint-plugin-next": "^15.1.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "clsx": "^2.1.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "wrangler": "^4.100.0"
  }
}
