# ──────────────────────────────────────────────────────────────────────────
# Munaxa Demo — environment.
# No database. The demo sandbox's integrations are all mocked; the only real
# outbound integration is the optional "Book a Demo" intake email (Resend).
# ──────────────────────────────────────────────────────────────────────────

# Secret used to sign the httpOnly demo session cookie (HMAC-SHA256), >= 16 chars.
# Generate one with:  openssl rand -base64 48
# REQUIRED in production: the app refuses to sign/verify sessions with the dev
# fallback when NODE_ENV=production (fails closed).
DEMO_SESSION_SECRET=

# Directory for the JSON file that persists admin-created demo accounts (no database)
# on a Node host. Defaults to ./.data. On Cloudflare Workers, accounts persist in the
# DEMO_ACCOUNTS KV namespace instead (see wrangler.jsonc) — this is ignored there.
DEMO_DATA_DIR=

# PBKDF2 password-hashing work factor. Node default is 600000 (OWASP). Lower it on
# Cloudflare Workers to fit CPU limits (wrangler.jsonc sets 100000).
DEMO_PBKDF2_ITERATIONS=

# Absolute session lifetime in minutes (default 120). After this the cookie is
# rejected and the user must sign in again — which fully resets demo data.
DEMO_SESSION_TTL_MINUTES=120

# Default expiration (in days) applied to newly provisioned demo accounts.
DEMO_DEFAULT_EXPIRY_DAYS=14

# ── "Book a Demo" intake emails (Resend) ───────────────────────────────────
# The public request form emails the team and acknowledges the prospect. This is
# the only real outbound integration; if the key is unset, requests are still saved
# and the admin queue works — sending is just skipped (fail-soft).
# The key is a SECRET (set via `wrangler secret put RESEND_DEMO`). The code accepts
# either RESEND_DEMO (preferred) or RESEND_API_KEY.
RESEND_DEMO=
# Team inbox that receives new-request notifications.
DEMO_NOTIFY_EMAIL=demo@munaxa.com
# Verified sender (the munaxa.com domain must be verified in Resend).
DEMO_FROM_EMAIL=Munaxa Demo <demo@munaxa.com>
