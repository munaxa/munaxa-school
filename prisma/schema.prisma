  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route            BusRoute?            @relation(fields: [routeId], references: [id], onDelete: SetNull)
  driver           Employee?            @relation("BusDriver", fields: [driverId], references: [id], onDelete: SetNull)
  attendanceEvents BusAttendanceEvent[]

  @@unique([tenantId, plateNumber])
  @@index([tenantId])
  @@index([driverId])
}

model BusStop {
