// ----------------------------------------------------------------------------
// School structure
// ----------------------------------------------------------------------------

model School {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  nameEn        String
  nameAr        String
  moeSchoolCode String?
  // IANA timezone (e.g. "Asia/Amman"). The scheduling engine resolves all live time-based state
  // (current class, breaks, holidays) in this zone — never in server/UTC time. Managed in Settings.
  timezone      String    @default("Asia/Amman")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses      Campus[]
  academicYears AcademicYear[]

  @@unique([tenantId, moeSchoolCode])
  @@index([tenantId])
}

model Campus {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  schoolId  String    @db.Uuid
  nameEn    String
  nameAr    String
  address   String?
  phone     String?
  isMain    Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYears      AcademicYear[]
  grades             Grade[]
  classrooms         Classroom[]
  enrollments        Enrollment[]
  timetableConfig    TimetableConfig?
  specialLocations   SpecialLocation[]
  bellSchedules      BellSchedule[]
  schedulePlans      SchedulePlan[]
  departments        Department[]
  employees          Employee[]
  attendancePolicies AttendancePolicy[]
  shifts             Shift[]
  attendanceLocks    AttendanceLock[]

  @@index([tenantId])
  @@index([tenantId, schoolId])
}

// Lifecycle of an Academic Year (Student-Lifecycle refactor, Decision 8). Never deleted; only ever
// moves UPCOMING → ACTIVE → CLOSED. Supersedes the legacy `isCurrent` boolean (isCurrent == ACTIVE).
enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

model AcademicYear {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @db.Uuid
  // TRANSITIONAL: an Academic Year is a SCHOOL-level entity (Decision 1); campuses participate but do
  // not own it. `campusId` is kept only as a migration shim and is dropped in the Phase-B cleanup once
  // the validator (scripts/validate-academic-year-migration.ts) confirms no (schoolId,name) conflicts.
  // New code should read/write `schoolId`; `schoolId` is backfilled from `campus.schoolId`.
  campusId              String             @db.Uuid
  schoolId              String?            @db.Uuid
  name                  String // e.g. "2025/2026"
  startDate             DateTime           @db.Date
  endDate               DateTime           @db.Date
  // Admission/registration window for the year (optional; independent of the instructional
  // boundaries, which live on Semester). Used by the workspace Registration section + readiness.
  registrationStartDate DateTime?          @db.Date
  registrationEndDate   DateTime?          @db.Date
  // Explicit lifecycle. `isCurrent` is retained (== status ACTIVE) for backward-compatible readers
  // during the transition; the single source of truth is `status`.
  status                AcademicYearStatus @default(UPCOMING)
  isCurrent             Boolean            @default(false)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus                 Campus                  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  school                 School?                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  semesters              Semester[]
  feeSchedules           GradeFeeSchedule[]
  transportFares         TransportFare[]
  gradeFeeItems          GradeFeeItem[]
  charges                Charge[]
  enrollmentQuotes       EnrollmentQuote[]
  enrollments            Enrollment[]
  financialAccountPlans  FinancialAccountPlan[]
  generatedDocuments     GeneratedDocument[]
  registrationAgreements RegistrationAgreement[]
  busRoutes              BusRoute[]
  serviceAreas           Area[]
  schedulePlans          SchedulePlan[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
  @@index([tenantId, schoolId])
  @@index([tenantId, status])
}

model Semester {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  academicYearId String   @db.Uuid
  name           String
  sequence       Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeRecords  GradeRecord[]
  schedulePlans SchedulePlan[]

  @@unique([tenantId, academicYearId, sequence])
  @@index([tenantId, academicYearId])
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  nameEn    String
  nameAr    String
  level     Int // ordinal, e.g. KG=0, G1=1 ...
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections         Section[]
  resources        Resource[]
  feeSchedules     GradeFeeSchedule[]
  gradeFeeItems    GradeFeeItem[]
  charges          Charge[]
  enrollmentQuotes EnrollmentQuote[]
  enrollments      Enrollment[]

  @@unique([tenantId, campusId, level])
  @@index([tenantId, campusId])
}

model Classroom {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  campusId  String   @db.Uuid
  name      String
  capacity  Int?
  building  String?
  floor     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections    Section[]
  enrollments Enrollment[]

  @@unique([tenantId, campusId, name])
  @@index([tenantId, campusId])
}

model Section {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  gradeId     String   @db.Uuid
  classroomId String?  @db.Uuid
  name        String // e.g. "A", "B"
  capacity    Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade              Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  classroom          Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  students           Student[]
  enrollments        Enrollment[]
  teacherSections    TeacherSection[]
  scheduleExceptions ScheduleException[]
  attendance         StudentAttendance[]
  homework           Homework[]
  gradeRecords       GradeRecord[]
  announcements      Announcement[]
  ptmSlots           PtmSlot[]
  resources          Resource[]
  sectionTimetables  SectionTimetable[]

  @@unique([tenantId, gradeId, name])
  @@index([tenantId, gradeId])
  @@index([tenantId, classroomId])
}

// ----------------------------------------------------------------------------
// People management
// ----------------------------------------------------------------------------

model Student {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  userId             String?       @unique @db.Uuid
  moeStudentNumber   String? // Ministry of Education student number
  nationalId         String? // Jordanian National ID (Raqam Watani)
  // Internal, school-generated student number (Decision 6). A PERMANENT identity attribute (does not
  // change between years), separate from National ID / MoE number. Auto-assigned from the per-tenant
  // StudentNumberCounter (configurable prefix / padding / start / reset). Printed on report cards, QR
  // cards, attendance sheets, library cards and certificates. Uniqueness is enforced by a PARTIAL
  // unique index (WHERE "studentNumber" IS NOT NULL AND "deletedAt" IS NULL) in the migration — not by
  // @@unique — so nulls and soft-deletes don't reserve a number. Never user-entered, never reassigned.
  studentNumber      String?
  firstNameEn        String
  lastNameEn         String
  firstNameAr        String
  lastNameAr         String
  // Full Arab/MoE name parts (given · father · grandfather · family). Optional/back-compat.
  fatherNameEn       String?
  fatherNameAr       String?
  thirdNameEn        String?
  thirdNameAr        String?
  dateOfBirth        DateTime?     @db.Date
  gender             Gender?
  // DEPRECATED SHIMS (Decisions 4 & 13): these are year-varying academic facts that now live on
  // Enrollment. They are retained ONLY for the transition — written as a read-through cache by the
  // EnrollmentLifecycleService (never edited directly) so existing readers (student lists, attendance,
  // portal, reporting) keep working — and are dropped in the Phase-B cleanup. The authoritative value
  // is the current Enrollment; "current status/placement" is a DERIVED projection, not stored here.
  sectionId          String?       @db.Uuid // DEPRECATED shim → Enrollment.sectionId (current year)
  qrCode             String        @unique
  status             StudentStatus @default(ACTIVE) // DEPRECATED shim → derived from current Enrollment
  areaId             String?       @db.Uuid // DEPRECATED shim → Enrollment.areaId
  transportRequested Boolean       @default(false) // DEPRECATED shim → Enrollment.transportRequested
  enrollmentDate     DateTime      @default(now()) @db.Timestamptz(6) // DEPRECATED shim → Enrollment.admissionDate
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?     @db.Timestamptz(6)

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  section                Section?                 @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  area                   Area?                    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  parentLinks            ParentStudent[]
  attendance             StudentAttendance[]
  behaviorLogs           BehaviorLog[]
  gradeRecords           GradeRecord[]
  financialAccount       StudentFinancialAccount?
  charges                Charge[]
  payments               Payment[]
  leaveRequests          LeaveRequest[]
  ptmBookings            PtmBooking[]
  documents              Document[]
  achievements           StudentAchievement[]
  gamification           StudentGamification?
  busAssignments         StudentBusAssignment[]
  bookLoans              BookLoan[]
  medicalRecord          StudentMedicalRecord?
  clinicVisits           ClinicVisit[]
  einvoiceDocuments      EInvoiceDocument[]
  adjustments            FeeAdjustment[]
  refunds                Refund[]
  billingProfile         StudentBillingProfile?
  presenceEvents         StudentPresenceEvent[]
  busAttendanceEvents    BusAttendanceEvent[]
  cards                  StudentCard[]
  vaccines               StudentVaccine[]
  enrollments            Enrollment[]
  enrollmentQuotes       EnrollmentQuote[]
  financialArrangements  FinancialArrangement[]
  generatedDocuments     GeneratedDocument[]
  registrationAgreements RegistrationAgreement[]

  // Uniqueness of nationalId / moeStudentNumber is enforced by PARTIAL unique indexes
  // (WHERE "deletedAt" IS NULL) created in migration 20260711120000_student_unique_partial —
  // NOT by Prisma @@unique — so that a soft-deleted student does not reserve their national-id /
  // MoE number and the same identifier can be registered again. Do not add @@unique here (it would
  // create plain indexes and reintroduce the "record already exists" bug against deleted rows).
  @@index([tenantId])
  @@index([tenantId, sectionId])
  @@index([tenantId, status])
  @@index([tenantId, areaId])
  @@index([tenantId, transportRequested])
}

model Parent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String?   @unique @db.Uuid
  firstNameEn String
  lastNameEn  String
  firstNameAr String
  lastNameAr  String
  phone       String?
  phoneAlt    String?
  email       String?
  nationalId  String?
  occupation  String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentLinks           ParentStudent[]
  payers                 Payer[]
  generatedDocuments     GeneratedDocument[]
  registrationAgreements RegistrationAgreement[]

  // Uniqueness is enforced by PARTIAL unique indexes (WHERE "deletedAt" IS NULL) created in
  // migration 20260622160000_parent_unique_partial — NOT by Prisma @@unique — so that a
  // soft-deleted parent does not reserve a mobile/national-id and the same person can be
  // re-added later. Do not add @@unique here (it would create plain indexes and reintroduce
  // the "record already exists" bug against deleted rows).
  @@index([tenantId])
}

model Teacher {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String?          @unique @db.Uuid
  // Academic facet of an HR Employee (HR transformation, Phase 1). Optional 1:1: a Teacher can be
  // linked to their canonical Employee record so HR data (contracts, leave, documents) lives in one
  // place, while section/schedule relations stay here. Nullable during onboarding and for legacy rows.
  employeeId     String?          @unique @db.Uuid
  employeeNumber String?
  firstNameEn    String
  lastNameEn     String
  firstNameAr    String
  lastNameAr     String
  specialization String?
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  employee               Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sections               TeacherSection[]
  scheduledClasses       ScheduledClass[]
  exceptionReplacements  ScheduleException[] @relation("ExceptionTeacher")
  exceptionSubstitutions ScheduleException[] @relation("ExceptionSubstitute")
  attendance             TeacherAttendance[]
  ptmSlots               PtmSlot[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
}

// The canonical HR "staff person" (HR transformation, Phase 1). Every non-student, non-parent
// human the school employs — teaching or not — is an Employee. `Teacher` is an optional academic
// facet linked 1:1 via Teacher.employeeId; a bus driver (Phase 3) is an Employee with a
// DriverProfile. Identity, employment, org placement and lifecycle live here; richer sub-records
// (contracts, documents, dependents, education, certificates, bank) arrive in Phase 2.
model Employee {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  userId   String? @unique @db.Uuid

  // --- Identity ---
  employeeNumber String? // human-facing staff number, unique per tenant among live rows
  firstNameEn    String
  lastNameEn     String
  firstNameAr    String
  lastNameAr     String
  nationalId     String?
  passportNumber String?
  nationality    String?
  visaNumber     String?
  visaExpiry     DateTime?      @db.Date
  gender         Gender?
  dateOfBirth    DateTime?      @db.Date
  maritalStatus  MaritalStatus?
  religion       String?
  personalEmail  String?
  personalPhone  String?
  photoUrl       String?

  // --- Employment ---
  jobTitle            String // always-present human-readable title; mirrors positionId when set
  employmentType      EmploymentType?
  status              EmploymentStatus @default(ACTIVE)
  hireDate            DateTime?        @db.Date
  probationEndDate    DateTime?        @db.Date
  terminationDate     DateTime?        @db.Date
  workingHoursPerWeek Decimal?         @db.Decimal(5, 2)

  // --- Org placement ---
  campusId     String? @db.Uuid
  departmentId String? @db.Uuid
  positionId   String? @db.Uuid
  managerId    String? @db.Uuid // reporting manager (self-reference → org chart)

  // --- Audit denormalisation (full trail lives in AuditLog) ---
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  campus                Campus?                       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department            Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position              Position?                     @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager               Employee?                     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports               Employee[]                    @relation("EmployeeManager")
  createdBy             User?                         @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy             User?                         @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  teacher               Teacher?
  statusHistory         EmployeeStatusHistory[]
  headOf                Department[]                  @relation("DepartmentHead")
  contracts             EmploymentContract[]
  documents             EmployeeDocument[]
  emergencyContacts     EmergencyContact[]
  dependents            Dependent[]
  education             EmployeeEducation[]
  certificates          Certificate[]
  bankAccounts          EmployeeBankAccount[]
  driverProfile         DriverProfile?
  busesDriven           Bus[]                         @relation("BusDriver")
  leaveBalances         StaffLeaveBalance[]
  leaveRequests         StaffLeaveRequest[]
  attendance            StaffAttendance[]
  performanceReviews    PerformanceReview[]
  performanceGoals      PerformanceGoal[]
  trainingRecords       TrainingRecord[]
  assetAssignments      AssetAssignment[]
  assets                Asset[]
  hiredFromApplicant    JobApplicant?                 @relation("ApplicantHire")
  shiftAssignments      EmployeeShiftAssignment[]
  attendanceCorrections AttendanceCorrectionRequest[]
  biometricPunches      BiometricRawPunch[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, campusId])
  @@index([managerId])
}

// An immutable, timestamped record of one employee lifecycle transition (HR transformation,
// Phase 1). Written in the same transaction as the status change; mirrored to AuditLog. Never
// updated or deleted — it is the employee's authoritative status timeline.
model EmployeeStatusHistory {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  employeeId    String            @db.Uuid
  fromStatus    EmploymentStatus? // null for the very first (creation) record
  toStatus      EmploymentStatus
  reason        String?
  effectiveDate DateTime?         @db.Date
  actorUserId   String?           @db.Uuid
  metadata      Json?
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actor    User?    @relation("EmployeeStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId, createdAt])
}

// Organisational unit within a school (HR transformation, Phase 1). Supports a self-referential
// hierarchy (division → department → team) and an optional campus scoping. `headEmployeeId` names
// the department manager. Reuses the existing Campus model — no duplicate campus concept.
model Department {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  campusId       String? @db.Uuid
  parentId       String? @db.Uuid
  headEmployeeId String? @db.Uuid
  name           String
  code           String?
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentTree")
  head        Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  employees   Employee[]
  positions   Position[]
  jobPostings JobPosting[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, campusId])
}

// A budgeted job position/title definition (HR transformation, Phase 1). Employees optionally
// occupy a Position; `budgetedHeadcount` minus filled positions yields vacancies for the org chart
// and drives the recruitment module (Phase 8).
model Position {
  id                String  @id @default(uuid()) @db.Uuid
  tenantId          String  @db.Uuid
  departmentId      String? @db.Uuid
  title             String
  code              String?
  description       String?
  budgetedHeadcount Int?
  isActive          Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees   Employee[]
  jobPostings JobPosting[]

  @@unique([tenantId, title])
  @@index([tenantId])
  @@index([tenantId, departmentId])
}

// ----------------------------------------------------------------------------
// HR Phase 2 — contracts, documents, and personal sub-records
// ----------------------------------------------------------------------------

// A formal employment contract for an employee. `renewedFromId` chains renewals/revisions so the
// full history is preserved; salary/allowances/benefits capture the commercial terms feeding
// payroll preparation (Phase 5). A signed PDF is linked via `signedDocumentId`.
model EmploymentContract {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  employeeId       String         @db.Uuid
  contractType     ContractType
  status           ContractStatus @default(DRAFT)
  title            String?
  startDate        DateTime       @db.Date
  endDate          DateTime?      @db.Date
  baseSalary       Decimal?       @db.Decimal(12, 3)
  currency         String?        @default("JOD")
  allowances       Json? // [{ name, amount }] — housing, transport, etc.
  benefits         String?
  workingHours     Decimal?       @db.Decimal(5, 2)
  vacationDays     Int?
  signedAt         DateTime?      @db.Timestamptz(6)
  signedDocumentId String?        @db.Uuid
  renewedFromId    String?        @db.Uuid
  notes            String?
  createdById      String?        @db.Uuid
  updatedById      String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?      @db.Timestamptz(6)

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  signedDocument EmployeeDocument?    @relation("ContractSignedDocument", fields: [signedDocumentId], references: [id], onDelete: SetNull)
  renewedFrom    EmploymentContract?  @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals       EmploymentContract[] @relation("ContractRenewal")
  createdBy      User?                @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?                @relation("ContractUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, endDate])
}

// A stored HR document (contract PDF, ID, passport, certificate, medical, licence…). Versioned via
// `supersedesId`: uploading a new version links back to the one it replaces, preserving history.
// `expiryDate` powers renewal reminders (Phase 10). Files live in S3 (fileKey), same as student docs.
model EmployeeDocument {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  employeeId   String               @db.Uuid
  type         EmployeeDocumentType @default(OTHER)
  title        String
  fileKey      String
  fileName     String
  contentType  String
  size         Int
  version      Int                  @default(1)
  supersedesId String?              @db.Uuid
  issueDate    DateTime?            @db.Date
  expiryDate   DateTime?            @db.Date
  uploadedById String?              @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  deletedAt    DateTime?            @db.Timestamptz(6)

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  supersedes       EmployeeDocument?    @relation("DocumentVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     EmployeeDocument[]   @relation("DocumentVersion")
  uploadedBy       User?                @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  contractsSigned  EmploymentContract[] @relation("ContractSignedDocument")
  certificateLinks Certificate[]        @relation("CertificateDocument")
  trainingRecords  TrainingRecord[]     @relation("TrainingCertificate")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, type])
  @@index([tenantId, expiryDate])
}

model EmergencyContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  employeeId String   @db.Uuid
  name       String
  relation   String
  phone      String
  phoneAlt   String?
  email      String?
  address    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
}

model Dependent {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  employeeId  String            @db.Uuid
  name        String
  relation    DependentRelation
  dateOfBirth DateTime?         @db.Date
  gender      Gender?
  nationalId  String?
  notes       String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
}

model EmployeeEducation {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  employeeId   String   @db.Uuid
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String?
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
}

model Certificate {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  employeeId   String    @db.Uuid
  name         String
  issuingBody  String?
  issueDate    DateTime? @db.Date
  expiryDate   DateTime? @db.Date
  credentialId String?
  documentId   String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  document EmployeeDocument? @relation("CertificateDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, expiryDate])
}

// Payroll bank details — sensitive; guarded by hr:sensitive:read on the read path.
model EmployeeBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  employeeId    String   @db.Uuid
  bankName      String
  accountName   String?
  accountNumber String?
  iban          String?
  swift         String?
  currency      String?  @default("JOD")
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
}

// The driving facet of an Employee (HR Phase 3). An employee becomes an assignable bus driver by
// gaining a DriverProfile. Holds licence + medical compliance (expiry-indexed for reminders) and a
// driving-performance rating; infractions are tracked in DriverInfraction. Buses reference the
// Employee directly (Bus.driverId), so route/assignment history comes from the Bus relation.
model DriverProfile {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  employeeId        String    @unique @db.Uuid
  licenseNumber     String?
  licenseClass      String?
  licenseExpiry     DateTime? @db.Date
  medicalCertExpiry DateTime? @db.Date
  medicalNotes      String?
  performanceRating Int? // 1–5 driving-performance rating
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime? @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  infractions DriverInfraction[]

  @@index([tenantId])
  @@index([tenantId, licenseExpiry])
  @@index([tenantId, medicalCertExpiry])
}

model DriverInfraction {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  driverProfileId String             @db.Uuid
  date            DateTime           @db.Date
  type            String
  description     String?
  severity        InfractionSeverity @default(MINOR)
  points          Int?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, driverProfileId])
}

// ----------------------------------------------------------------------------
// HR Phase 4 — staff leave management
// ----------------------------------------------------------------------------

// A configurable staff leave category (Annual, Sick, Unpaid, Maternity, Hajj…). `paid` feeds
// payroll preparation; `approvalLevels` drives the multi-level approval chain.
model StaffLeaveType {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  name              String
  code              String?
  paid              Boolean   @default(true)
  defaultAnnualDays Int? // default entitlement seeded into balances
  approvalLevels    Int       @default(1)
  colorHex          String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime? @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances StaffLeaveBalance[]
  requests StaffLeaveRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// An employee's leave entitlement + consumption for one type in one year.
model StaffLeaveBalance {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  employeeId   String   @db.Uuid
  leaveTypeId  String   @db.Uuid
  year         Int
  entitledDays Decimal  @default(0) @db.Decimal(6, 2)
  usedDays     Decimal  @default(0) @db.Decimal(6, 2)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType StaffLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@index([tenantId, employeeId])
}

// A staff leave request with a multi-level approval chain (StaffLeaveApproval). `workingDays`
// excludes the Fri/Sat weekend; deducted from the matching balance on final approval.
model StaffLeaveRequest {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  employeeId     String           @db.Uuid
  leaveTypeId    String           @db.Uuid
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  workingDays    Decimal          @db.Decimal(6, 2)
  reason         String?
  status         StaffLeaveStatus @default(PENDING)
  currentLevel   Int              @default(1)
  requiredLevels Int              @default(1)
  requestedById  String?          @db.Uuid
  decidedAt      DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   StaffLeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  requestedBy User?                @relation("StaffLeaveRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvals   StaffLeaveApproval[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model StaffLeaveApproval {
  id         String                @id @default(uuid()) @db.Uuid
  tenantId   String                @db.Uuid
  requestId  String                @db.Uuid
  level      Int
  decision   LeaveApprovalDecision
  note       String?
  approverId String?               @db.Uuid
  decidedAt  DateTime              @default(now()) @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request  StaffLeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User?             @relation("StaffLeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, requestId])
}

// Per-employee daily attendance for HR/payroll (HR Phase 5). Overtime + late minutes feed payroll
// preparation; a correction records the prior status + who changed it (audited trail).
model StaffAttendance {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @db.Uuid
  employeeId          String                 @db.Uuid
  date                DateTime               @db.Date
  status              StaffAttendanceStatus
  source              StaffAttendanceSource  @default(MANUAL)
  checkInAt           DateTime?              @db.Timestamptz(6)
  checkOutAt          DateTime?              @db.Timestamptz(6)
  lateMinutes         Int?
  overtimeHours       Decimal?               @db.Decimal(5, 2)
  note                String?
  correctedFromStatus StaffAttendanceStatus?
  correctedById       String?                @db.Uuid
  correctedAt         DateTime?              @db.Timestamptz(6)
  markedById          String?                @db.Uuid
  createdAt           DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(6)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  markedBy    User?    @relation("StaffAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  correctedBy User?    @relation("StaffAttendanceCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, employeeId])
}

// HR Phase 6 — a named appraisal period (e.g. "2026 Annual"). Reviews attach to a cycle.
model PerformanceCycle {
  id        String                 @id @default(uuid()) @db.Uuid
  tenantId  String                 @db.Uuid
  name      String
  startDate DateTime               @db.Date
  endDate   DateTime               @db.Date
  status    PerformanceCycleStatus @default(DRAFT)
  createdAt DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?              @db.Timestamptz(6)

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews PerformanceReview[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// One employee's appraisal within a cycle. Rating 1–5; the review is drafted, submitted by the
// reviewer, and acknowledged by the employee. Goals hang off the review.
model PerformanceReview {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @db.Uuid
  cycleId        String                  @db.Uuid
  employeeId     String                  @db.Uuid
  reviewerId     String?                 @db.Uuid
  status         PerformanceReviewStatus @default(DRAFT)
  overallRating  Int? // 1–5
  summary        String?
  strengths      String?
  improvements   String?
  submittedAt    DateTime?               @db.Timestamptz(6)
  acknowledgedAt DateTime?               @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle    PerformanceCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer User?             @relation("PerformanceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  goals    PerformanceGoal[]

  @@unique([tenantId, cycleId, employeeId])
  @@index([tenantId])
  @@index([tenantId, cycleId])
  @@index([tenantId, employeeId])
}

// A SMART goal within a review. `weight` lets ratings be weighted; `progress` is 0–100.
model PerformanceGoal {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  reviewId    String                @db.Uuid
  employeeId  String                @db.Uuid
  title       String
  description String?
  weight      Int                   @default(1)
  progress    Int                   @default(0) // 0–100
  status      PerformanceGoalStatus @default(NOT_STARTED)
  rating      Int? // 1–5
  dueDate     DateTime?             @db.Date
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review   PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, reviewId])
  @@index([tenantId, employeeId])
}

// HR Phase 6 — training catalog. A course an employee can be enrolled in / complete.
model TrainingCourse {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  title       String
  description String?
  category    String?
  provider    String?
  hours       Decimal?  @db.Decimal(5, 2)
  mandatory   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records TrainingRecord[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// An employee's participation in a course. `expiresAt` supports renewable certifications;
// `certificateId` links the earned certificate to the existing EmployeeDocument store (reuse).
model TrainingRecord {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  courseId      String               @db.Uuid
  employeeId    String               @db.Uuid
  status        TrainingRecordStatus @default(ENROLLED)
  enrolledAt    DateTime             @default(now()) @db.Timestamptz(6)
  completedAt   DateTime?            @db.Timestamptz(6)
  score         Decimal?             @db.Decimal(5, 2)
  expiresAt     DateTime?            @db.Date
  certificateId String?              @db.Uuid
  note          String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      TrainingCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certificate EmployeeDocument? @relation("TrainingCertificate", fields: [certificateId], references: [id], onDelete: SetNull)

  @@unique([tenantId, courseId, employeeId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
}

// HR Phase 7 — a discrete, custody-tracked asset (laptop, key, uniform, vehicle…). Distinct from the
// fungible-stock InventoryItem: each Asset is an individual unit with a lifecycle and an assignment
// (custody) history. `currentAssignee` denormalises the active holder for fast directory listing.
model Asset {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  assetTag          String
  name              String
  category          AssetCategory  @default(OTHER)
  serialNumber      String?
  status            AssetStatus    @default(AVAILABLE)
  condition         AssetCondition @default(GOOD)
  purchaseDate      DateTime?      @db.Date
  purchaseCost      Decimal?       @db.Decimal(12, 2)
  warrantyExpiry    DateTime?      @db.Date
  location          String?
  notes             String?
  currentAssigneeId String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?      @db.Timestamptz(6)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentAssignee Employee?         @relation(fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  assignments     AssetAssignment[]

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, currentAssigneeId])
}

// One custody record: an asset issued to an employee, later returned. An asset has at most one open
// (unreturned) assignment at a time; the return records the condition it came back in.
model AssetAssignment {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  assetId         String          @db.Uuid
  employeeId      String          @db.Uuid
  assignedAt      DateTime        @default(now()) @db.Timestamptz(6)
  dueDate         DateTime?       @db.Date
  returnedAt      DateTime?       @db.Timestamptz(6)
  returnCondition AssetCondition?
  assignedById    String?         @db.Uuid
  note            String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AssetAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@index([tenantId, employeeId])
  @@index([tenantId, returnedAt])
}

// HR Phase 8 — a job vacancy. Optionally tied to a Department/Position (org engine, Phase 1); a
// hired applicant becomes a real Employee (lifecycle Phase 1), closing the recruitment loop.
model JobPosting {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  departmentId   String?          @db.Uuid
  positionId     String?          @db.Uuid
  title          String
  description    String?
  employmentType EmploymentType?
  location       String?
  headcount      Int              @default(1)
  status         JobPostingStatus @default(DRAFT)
  openedAt       DateTime?        @db.Timestamptz(6)
  closedAt       DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?        @db.Timestamptz(6)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  applicants JobApplicant[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
}

// A candidate for a posting. On HIRED, `hiredEmployeeId` links the created Employee row (1:1).
model JobApplicant {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  postingId       String          @db.Uuid
  firstName       String
  lastName        String
  email           String?
  phone           String?
  source          String?
  resumeUrl       String?
  status          ApplicantStatus @default(APPLIED)
  rating          Int? // 1–5
  notes           String?
  hiredEmployeeId String?         @unique @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posting       JobPosting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
  hiredEmployee Employee?   @relation("ApplicantHire", fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  interviews    Interview[]

  @@index([tenantId])
  @@index([tenantId, postingId])
  @@index([tenantId, status])
}

// A scheduled interview for an applicant, with an interviewer and an outcome.
model Interview {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  applicantId   String           @db.Uuid
  interviewerId String?          @db.Uuid
  scheduledAt   DateTime         @db.Timestamptz(6)
  mode          InterviewMode    @default(ONSITE)
  stage         String?
  outcome       InterviewOutcome @default(PENDING)
  rating        Int? // 1–5
  feedback      String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant   JobApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewer User?        @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, applicantId])
  @@index([tenantId, scheduledAt])
}

model ParentStudent {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  parentId  String         @db.Uuid
  studentId String         @db.Uuid
  relation  ParentRelation
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model TeacherSection {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  teacherId String   @db.Uuid
  sectionId String   @db.Uuid
  subject   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([teacherId])
  @@index([sectionId])
}

// ----------------------------------------------------------------------------
// Identity & Access (IAM)
// ----------------------------------------------------------------------------

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  tenantId               String     @db.Uuid
  firebaseUid            String?    @unique
  email                  String
  // Optional login handle (e.g. for students/parents without email). Unique per tenant.
  username               String?
  phone                  String?
  nationalId             String? // Jordanian National ID (Raqam Watani)
  firstNameEn            String?
  lastNameEn             String?
  firstNameAr            String?
  lastNameAr             String?
  status                 UserStatus @default(INVITED)
  // Local-login credential (Argon2/bcrypt hash). Null for Firebase-only accounts.
  passwordHash           String?
  passwordUpdatedAt      DateTime?  @db.Timestamptz(6)
  mustChangePassword     Boolean    @default(true)
  // Temporary-password reset lifecycle. `passwordResetIssuedAt`/`passwordResetExpiresAt` are set
  // when a temporary password is generated (Forgot Password); the temp password is only valid
  // while `mustChangePassword` is true and now < `passwordResetExpiresAt` (24h window).
  passwordResetIssuedAt  DateTime?  @db.Timestamptz(6)
  passwordResetExpiresAt DateTime?  @db.Timestamptz(6)
  // Set on every successful self-service password change (distinct from admin-set passwordUpdatedAt).
  lastPasswordChangeAt   DateTime?  @db.Timestamptz(6)
  lastLoginAt            DateTime?  @db.Timestamptz(6)
  createdAt              DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?  @db.Timestamptz(6)

  tenant                         Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles                      UserRole[]
  refreshTokens                  RefreshToken[]
  passwordResets                 PasswordResetToken[]
  passwordResetAudits            PasswordResetAudit[]
  studentProfile                 Student?
  parentProfile                  Parent?
  teacherProfile                 Teacher?
  employeeProfile                Employee?
  employeesCreated               Employee[]                     @relation("EmployeeCreatedBy")
  employeesUpdated               Employee[]                     @relation("EmployeeUpdatedBy")
  employeeStatusChanges          EmployeeStatusHistory[]        @relation("EmployeeStatusActor")
  contractsCreated               EmploymentContract[]           @relation("ContractCreatedBy")
  contractsUpdated               EmploymentContract[]           @relation("ContractUpdatedBy")
  employeeDocsUploaded           EmployeeDocument[]             @relation("EmployeeDocumentUploadedBy")
  staffLeaveRequested            StaffLeaveRequest[]            @relation("StaffLeaveRequestedBy")
  staffLeaveApproved             StaffLeaveApproval[]           @relation("StaffLeaveApprover")
  staffAttendanceMarked          StaffAttendance[]              @relation("StaffAttendanceMarkedBy")
  staffAttendanceCorrected       StaffAttendance[]              @relation("StaffAttendanceCorrectedBy")
  performanceReviewsGiven        PerformanceReview[]            @relation("PerformanceReviewer")
  assetsAssigned                 AssetAssignment[]              @relation("AssetAssignedBy")
  interviewsConducted            Interview[]                    @relation("Interviewer")
  studentAttendanceMarks         StudentAttendance[]            @relation("StudentAttendanceMarkedBy")
  teacherAttendanceMarks         TeacherAttendance[]            @relation("TeacherAttendanceMarkedBy")
  notifications                  Notification[]
  notificationPreference         NotificationPreference?
  deviceTokens                   DeviceToken[]
  auditLogs                      AuditLog[]                     @relation("AuditActor")
  leaveRequestsMade              LeaveRequest[]                 @relation("LeaveRequestedBy")
  leaveRequestsReviewed          LeaveRequest[]                 @relation("LeaveReviewedBy")
  ptmSlotsCreated                PtmSlot[]                      @relation("PtmSlotCreatedBy")
  ptmBookingsMade                PtmBooking[]                   @relation("PtmBookedBy")
  documentsUploaded              Document[]                     @relation("DocumentUploadedBy")
  resourcesUploaded              Resource[]                     @relation("ResourceUploadedBy")
  achievementsAwarded            StudentAchievement[]           @relation("AchievementAwardedBy")
  shiftAssignmentsCreated        EmployeeShiftAssignment[]      @relation("ShiftAssignmentCreatedBy")
  attendanceLocksCreated         AttendanceLock[]               @relation("AttendanceLockedBy")
  attendanceLocksReleased        AttendanceLock[]               @relation("AttendanceLockReleasedBy")
  attendanceCorrectionsRequested AttendanceCorrectionRequest[]  @relation("AttendanceCorrectionRequestedBy")
  attendanceCorrectionsDecided   AttendanceCorrectionApproval[] @relation("AttendanceCorrectionDecidedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, nationalId])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([tenantId, status])
}

// Roles are tenant-scoped for the School plane; Platform-plane system roles use a
// null tenantId. Uniqueness is enforced per (tenantId, key).
model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  // System roles use a @school/domain RoleKey (e.g. "Teacher"); custom per-tenant roles use a
  // generated slug (e.g. "custom-front-desk"). Stored as text so tenants can define their own.
  key       String
  scope     RoleScope
  isSystem  Boolean   @default(true)
  nameEn    String?
  nameAr    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Global permission catalog (not tenant-scoped). Seeded from @school/domain.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "attendance:create"
  category    String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
}

// ----------------------------------------------------------------------------
// Auth: rotating refresh tokens (hashed) with reuse detection
// ----------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  // SHA-256 of the opaque refresh token; the raw token is never stored.
  tokenHash         String    @unique
  // Token family for rotation/reuse detection. Reuse of a rotated token revokes the family.
  familyId          String    @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  // Set when this token was rotated; pointing at its successor.
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

// Dedicated, append-only audit trail for the temporary-password / forgot-password workflow.
// Kept separate from the generic AuditLog so password-reset activity (incl. failed/anonymous
// attempts) has a focused, queryable history. `email` is captured as-supplied so reset requests
// for non-existent or already-deleted accounts are still recorded for abuse analysis.
model PasswordResetAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid // null when the email did not resolve to a tenant user
  userId    String?  @db.Uuid // null for unknown-email / pre-resolution events
  email     String
  // e.g. "reset.request", "reset.email_sent", "reset.first_login", "reset.completed",
  // "reset.expired_attempt".
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([email, createdAt])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Audit (append-only)
// ----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid // null for platform-level events
  actorUserId String?  @db.Uuid
  actorRole   String?
  onBehalfOf  String?  @db.Uuid // set for support impersonation
  action      String // e.g. "transaction.create"
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?
  traceId     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
}

// ----------------------------------------------------------------------------
// Timetable — schedule exceptions & Ramadan config
// (The weekly schedule itself lives in the enterprise scheduling engine below.)
// ----------------------------------------------------------------------------

// A date-specific override of the published schedule: a cancelled class, a substitute teacher, a
// replaced subject, or a whole-day holiday (classNumber null + sectionId null => school-wide).
// Exceptions never edit the master plan — they overlay it for a single date.
model ScheduleException {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  date                DateTime      @db.Date
  sectionId           String?       @db.Uuid
  classNumber         Int?
  type                ExceptionType
  // For REPLACEMENT: the subject the class is replaced with (Subject is the single source of truth).
  subjectId           String?       @db.Uuid
  teacherId           String?       @db.Uuid // replacement teacher
  substituteTeacherId String?       @db.Uuid
  // Optional special location for the overridden lesson (lab/gym/etc.); null ⇒ section's classroom.
  locationId          String?       @db.Uuid
  note                String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher    Teacher?         @relation("ExceptionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  substitute Teacher?         @relation("ExceptionSubstitute", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  location   SpecialLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([tenantId, sectionId, date])
}

// Per-campus timetable settings, notably Ramadan mode and its active window.
model TimetableConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  campusId           String    @unique @db.Uuid
  ramadanModeEnabled Boolean   @default(false)
  ramadanStartDate   DateTime? @db.Date
  ramadanEndDate     DateTime? @db.Date
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Enterprise scheduling engine
//
// Hierarchy:  AcademicYear → Semester → SchedulePlan → SectionTimetable → ScheduledClass
//
// A timetable belongs to a SECTION (never a student). Students, parents and teachers inherit the
// schedule of their section's PUBLISHED plan through their active Enrollment / TeacherSection; no
// per-person timetable rows exist. The pure resolution engine lives in
// apps/api/src/timetable/engine/scheduling-engine.ts.
//
// This REPLACES the legacy flat TimetableSlot model (dropped in the 20260720120000_scheduling_engine
// migration — the previous timetable data was development/test only, so no compatibility layer is
// kept). ScheduleException + TimetableConfig above are retained and modernised to reference these.
// ----------------------------------------------------------------------------

// A managed, tenant-scoped subject with a stable display colour (used everywhere the timetable is
// drawn) and an optional short code. Replaces free-text subject strings on ScheduledClass.
model Subject {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  nameEn    String
  nameAr    String
  code      String? // short code, e.g. "MATH"
  colorHex  String    @default("#64748b") // consistent subject colour for the grid
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduledClasses   ScheduledClass[]
  scheduleExceptions ScheduleException[]

  // (tenantId, code) uniqueness is enforced by a PARTIAL unique index (WHERE code IS NOT NULL AND
  // deletedAt IS NULL) in the migration, so nulls / soft-deletes don't reserve a code.
  @@index([tenantId])
  @@index([tenantId, isActive])
}

// An optional special lesson location (lab / gym / library …). Normal lessons occur in the section's
// assigned classroom and never display a room number; only exceptional lessons reference one of these.
model SpecialLocation {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  campusId  String              @db.Uuid
  nameEn    String
  nameAr    String
  kind      SpecialLocationKind @default(OTHER)
  capacity  Int?
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?           @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  scheduledClasses   ScheduledClass[]
  scheduleExceptions ScheduleException[]

  @@index([tenantId, campusId])
}

// A reusable "school class times" definition (bell schedule) for a campus — the class numbers and
// their start/end times, optionally per ScheduleType (REGULAR vs RAMADAN). Used to pre-fill the grid;
// ScheduledClass still stores its own times so a plan is self-contained once built.
model BellSchedule {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  campusId     String       @db.Uuid
  name         String
  scheduleType ScheduleType @default(REGULAR)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus  Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  periods BellSchedulePeriod[]

  @@index([tenantId, campusId])
}

// A single class-time row within a BellSchedule. `isBreak` rows (assembly / break / lunch) carry no
// subject and are rendered as gaps.
model BellSchedulePeriod {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  bellScheduleId String   @db.Uuid
  classNumber    Int
  startTime      String // "HH:MM"
  endTime        String // "HH:MM"
  isBreak        Boolean  @default(false)
  labelEn        String?
  labelAr        String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bellSchedule BellSchedule @relation(fields: [bellScheduleId], references: [id], onDelete: Cascade)

  @@unique([bellScheduleId, classNumber])
  @@index([tenantId, bellScheduleId])
}

// A versioned scheduling plan for a semester. Only one PUBLISHED plan per semester (enforced by a
// partial unique index in the migration). DRAFT is editable; PUBLISHED is read-only and is the single
// source of truth for every downstream reader; ARCHIVED is historical.
model SchedulePlan {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  semesterId     String             @db.Uuid
  // Denormalised for cheap scoping / filtering (kept consistent with the semester's year).
  academicYearId String             @db.Uuid
  campusId       String             @db.Uuid
  name           String
  status         SchedulePlanStatus @default(DRAFT)
  publishedAt    DateTime?          @db.Timestamptz(6)
  publishedById  String?            @db.Uuid
  archivedAt     DateTime?          @db.Timestamptz(6)
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?          @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  semester          Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  campus            Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sectionTimetables SectionTimetable[]

  @@index([tenantId, semesterId])
  @@index([tenantId, semesterId, status])
}

// The weekly timetable a plan holds for one section. Exactly one per (plan, section).
model SectionTimetable {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  planId    String    @db.Uuid
  sectionId String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan    SchedulePlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  section Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classes ScheduledClass[]

  @@unique([planId, sectionId])
  @@index([tenantId, planId])
  @@index([tenantId, sectionId])
}

// A single scheduled "Class" (formerly Period) within a section's weekly timetable. Keyed by
// (sectionTimetable, scheduleType, dayOfWeek, classNumber). Location is optional: null ⇒ the lesson
// occurs in the section's assigned classroom (not displayed as a room number).
model ScheduledClass {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  sectionTimetableId String       @db.Uuid
  scheduleType       ScheduleType @default(REGULAR)
  dayOfWeek          DayOfWeek
  classNumber        Int
  startTime          String // "HH:MM"
  endTime            String // "HH:MM"
  subjectId          String       @db.Uuid
  teacherId          String?      @db.Uuid
  locationId         String?      @db.Uuid // optional SpecialLocation; null ⇒ section's classroom
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionTimetable SectionTimetable @relation(fields: [sectionTimetableId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher          Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  location         SpecialLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([sectionTimetableId, scheduleType, dayOfWeek, classNumber])
  @@index([tenantId, sectionTimetableId])
  @@index([tenantId, teacherId])
  @@index([tenantId, subjectId])
}

// ----------------------------------------------------------------------------
// Attendance
// ----------------------------------------------------------------------------

// Student attendance. classNumber 0 = daily/homeroom; >0 = per-class. Unique per
// (student, date, class) so offline re-sync is idempotent (upsert on that key).
model StudentAttendance {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  studentId   String           @db.Uuid
  sectionId   String           @db.Uuid
  date        DateTime         @db.Date
  classNumber Int              @default(0)
  status      AttendanceStatus
  method      AttendanceMethod @default(MANUAL)
  note        String?
  markedById  String?          @db.Uuid
  // Client-generated id from the offline queue (audit/debug; idempotency uses the unique key).
  clientRef   String?
  recordedAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("StudentAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, date, classNumber])
  @@index([tenantId, sectionId, date])
  @@index([tenantId, studentId, date])
}

model TeacherAttendance {
  id         String                  @id @default(uuid()) @db.Uuid
  tenantId   String                  @db.Uuid
  teacherId  String                  @db.Uuid
  date       DateTime                @db.Date
  status     TeacherAttendanceStatus
  checkInAt  DateTime?               @db.Timestamptz(6)
  note       String?
  markedById String?                 @db.Uuid
  recordedAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, teacherId, date])
  @@index([tenantId, date])
}

// ----------------------------------------------------------------------------
// Academics
// ----------------------------------------------------------------------------

model Homework {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  sectionId    String    @db.Uuid
  subject      String
  title        String
  description  String?
  dueDate      DateTime  @db.Date
  assignedById String?   @db.Uuid // teacher/user; plain ref (no FK relation)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attachments HomeworkAttachment[]

  @@index([tenantId, sectionId])
  @@index([tenantId, dueDate])
}

// Attachment metadata. Files live in S3 and are uploaded directly via pre-signed URLs;
// only the object key + metadata are stored here.
model HomeworkAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  homeworkId   String   @db.Uuid
  fileName     String
  fileKey      String // S3 object key
  contentType  String
  size         Int
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([tenantId, homeworkId])
}

model BehaviorLog {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  studentId    String       @db.Uuid
  type         BehaviorType
  category     String?
  title        String
  description  String?
  points       Int          @default(0)
  date         DateTime     @db.Date
  recordedById String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, date])
}

// A graded assessment. Unique per (student, subject, assessment, semester) so grade import
// is idempotent (re-importing updates the score rather than duplicating).
model GradeRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  studentId  String   @db.Uuid
  sectionId  String?  @db.Uuid
  semesterId String?  @db.Uuid
  subject    String
  assessment String // e.g. "Midterm", "Quiz 1"
  score      Decimal  @db.Decimal(6, 2)
  maxScore   Decimal  @db.Decimal(6, 2)
  weight     Decimal? @db.Decimal(5, 2)
  gradedById String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, subject, assessment, semesterId])
  @@index([tenantId, studentId])
  @@index([tenantId, sectionId])
}

// ----------------------------------------------------------------------------
// Finance (no online gateway: payments are recorded; CliQ/e-wallet via receipt upload)
// ----------------------------------------------------------------------------

// ============================================================================
// Accounts Receivable (AR) core — Finance Domain Specification v1.0.
//   StudentFinancialAccount → Charge → PaymentPlan → Installment
//                          ↳ Payment → PaymentAllocation (→ Installment)
//                          ↳ Credit → RefundConsumption ← Refund
//   A Charge is the financial OBLIGATION; a PaymentPlan is HOW it may be paid;
//   an Installment is WHEN a portion is due; a Payment is money RECEIVED; an
//   Allocation applies money to an Installment. These concepts never merge.
// ============================================================================

/// A billing party (guardian/company) that may be responsible for one or more
/// student accounts and may hold payments/credits. Receivables stay owned by the
/// student account (BR-3, ADR-003).
/// The FINANCIAL ACCOUNT — the customer that pays for one or more students' services (the
/// "control account" over the per-student subsidiary ledgers). Usually a guardian, but the payer is
/// NOT hard-coded: `ownerType` supports company/government/sponsor/charity/etc. Owns the payment
/// plan(s), payments, credits, refunds, statements, agreements and collections. Students remain the
/// owners of their charges; the allocation engine bridges the two. Every ledger row already
/// references this via `payerId` (Payment/Credit/Refund/StudentFinancialAccount) — so this single
/// entity IS the account (no separate FinancialAccount table).
model Payer {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @db.Uuid
  parentId    String?                   @db.Uuid // the guardian person, when the account is owned by one
  ownerType   FinancialAccountOwnerType @default(GUARDIAN)
  nameEn      String
  nameAr      String
  phone       String?
  email       String?
  nationalId  String? // billing party's national id (JoFotara buyer identity)
  taxId       String? // billing party's tax number (JoFotara), when applicable
  currency    String                    @default("JOD")
  status      AccountStatus             @default(ACTIVE)
  createdById String?                   @db.Uuid
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(6)

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          Parent?                   @relation(fields: [parentId], references: [id], onDelete: SetNull)
  accounts        StudentFinancialAccount[]
  payments        Payment[]
  credits         Credit[]
  refunds         Refund[]
  plans           FinancialAccountPlan[]
  collectionsCase CollectionsCase?

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, status])
}

/// The AR ledger owner for one student: currency, status, optional payer. Every
/// financial row for the student hangs off this account (BR-1, BR-2, BR-4).
model StudentFinancialAccount {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  studentId String        @unique @db.Uuid
  // The Financial Account (Payer) this student's charges are billed through. Set to the guardian's
  // account by default; the same payer is shared by siblings, which is how the account groups them.
  payerId   String?       @db.Uuid
  currency  String        @default("JOD")
  status    AccountStatus @default(ACTIVE)
  openedAt  DateTime      @default(now()) @db.Timestamptz(6)
  closedAt  DateTime?     @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payer           Payer?           @relation(fields: [payerId], references: [id], onDelete: SetNull)
  charges         Charge[]
  payments        Payment[]
  adjustments     FeeAdjustment[]
  credits         Credit[]
  refunds         Refund[]
  collectionsCase CollectionsCase?

  @@index([tenantId])
  @@index([tenantId, payerId])
}

/// A single financial OBLIGATION owed by one account (e.g. "Annual Tuition 2026/27").
/// Never split into sub-charges; paid via 0..1 active PaymentPlan (BR-5..10, ADR-001).
model Charge {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  accountId      String       @db.Uuid
  studentId      String       @db.Uuid // denormalised for RLS-friendly filters + reporting
  // Reporting dimensions (RR-2) — nullable when not derivable.
  academicYearId String?      @db.Uuid
  gradeId        String?      @db.Uuid
  campusId       String?      @db.Uuid
  feeItemId      String?      @db.Uuid
  enrollmentId   String?      @db.Uuid
  description    String
  amount         Decimal      @db.Decimal(12, 3)
  currency       String       @default("JOD")
  dueDate        DateTime?    @db.Date // pay-in-full due when there is no plan
  status         ChargeStatus @default(PENDING)
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear?           @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  grade             Grade?                  @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  feeItem           FeeItem?                @relation(fields: [feeItemId], references: [id], onDelete: SetNull)
  plans             PaymentPlan[] // one ACTIVE at a time (partial unique index); history retained
  installments      Installment[]
  adjustments       FeeAdjustment[]
  einvoiceDocuments EInvoiceDocument[]

  @@index([tenantId, accountId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, academicYearId])
  @@index([tenantId, feeItemId])
}

/// HOW a charge may be paid over time: cadence, count, terms, status. 0..1 active per
/// charge; superseding regenerates the schedule for the remaining balance (BR-11..13, ADR-001).
model PaymentPlan {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  chargeId        String             @db.Uuid
  // The family/customer plan this per-charge plan is aligned to (shared cadence + due dates), when the
  // charge is billed through a FinancialAccount. NULL for legacy per-student plans.
  financialPlanId String?            @db.Uuid
  cadence         PaymentPlanCadence @default(MONTHLY)
  installments    Int
  firstDueDate    DateTime           @db.Date
  balloonFinal    Boolean            @default(false)
  status          PaymentPlanStatus  @default(ACTIVE)
  createdById     String?            @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge          Charge                @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  financialPlan   FinancialAccountPlan? @relation(fields: [financialPlanId], references: [id], onDelete: SetNull)
  installmentRows Installment[]

  // At most one ACTIVE plan per charge is enforced by a partial unique index (see migration).
  @@index([tenantId, chargeId])
  @@index([tenantId, status])
  @@index([tenantId, financialPlanId])
}

/// WHEN a scheduled portion of a charge's net is expected. A schedule line — never a
/// charge, never invoiced. Σ installment.amount == charge.net (BR-9, BR-14, IR-2).
model Installment {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  chargeId  String            @db.Uuid // denormalised for direct account/aging scans
  planId    String?           @db.Uuid // null = the implicit single installment of a plan-less charge
  seq       Int
  dueDate   DateTime?         @db.Date
  amount    Decimal           @db.Decimal(12, 3)
  status    InstallmentStatus @default(SCHEDULED)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge      Charge              @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  plan        PaymentPlan?        @relation(fields: [planId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@index([tenantId, chargeId])
  @@index([tenantId, planId])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
}

/// Actual money RECEIVED. CliQ/e-wallet payments are uploaded as receipts (receiptKey in S3)
/// and start PENDING until a FinanceOfficer verifies them; a gapless receiptNo is assigned
/// once, at verify. Allocations apply the money to installments (BR-17..25).
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  accountId        String        @db.Uuid
  studentId        String        @db.Uuid
  payerId          String?       @db.Uuid // the Financial Account this payment belongs to
  // TRUE for a Financial-Account (unified) payment: verify auto-allocates the money across ALL the
  // account's students' open installments (cross-student FIFO) and banks residue as account credit.
  // FALSE (legacy) keeps the old student-scoped allocation (within accountId/studentId only), so
  // existing single-student billing is unchanged. `payerId` is set on both kinds (billing identity),
  // so this flag — not the payer — distinguishes the allocation scope.
  accountScoped    Boolean       @default(false)
  amount           Decimal       @db.Decimal(12, 3)
  currency         String        @default("JOD")
  method           PaymentMethod
  reference        String? // e.g. CliQ reference
  receiptKey       String? // S3 object key for an uploaded receipt
  receiptNo        Int? // gapless per-tenant official receipt number (assigned at verify)
  status           PaymentStatus @default(PENDING)
  note             String?
  recordedById     String?       @db.Uuid
  verifiedById     String?       @db.Uuid
  verifiedAt       DateTime?     @db.Timestamptz(6)
  parentNotifiedAt DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payer             Payer?                  @relation(fields: [payerId], references: [id], onDelete: SetNull)
  allocations       PaymentAllocation[]
  credits           Credit[]
  einvoiceDocuments EInvoiceDocument[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId, accountId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, payerId])
}

/// Row-locked, per-tenant counter that hands out gapless receipt numbers for verified payments
/// (same pattern as EInvoiceCounter / the JoFotara ICV). Created lazily on first use (BR-18, MT-3).
model PaymentReceiptCounter {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @unique @db.Uuid
  nextReceiptNo Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// How the internal Student Number sequence resets (Decision 6). NEVER (default) is an ever-increasing
/// sequence; ANNUAL is reserved for a future per-year reset. Only NEVER is implemented today.
enum StudentNumberResetPolicy {
  NEVER
  ANNUAL
}

/// Row-locked, per-tenant counter + format config for the internal Student Number (Decision 6). Same
/// gapless pattern as PaymentReceiptCounter/EInvoiceCounter, created lazily on first use. Configurable
/// per school: optional `prefix`, `padLength`, starting value (the initial `nextNumber`) and
/// `resetPolicy`. Default: no prefix, zero-padded to 6, starting at 1, never resets (e.g. "000001";
/// with prefix "S-" → "S-000001").
model StudentNumberCounter {
  id          String                   @id @default(uuid()) @db.Uuid
  tenantId    String                   @unique @db.Uuid
  prefix      String? // optional literal prefix, e.g. "S-" or "2026-"
  padLength   Int                      @default(6)
  nextNumber  Int                      @default(1)
  resetPolicy StudentNumberResetPolicy @default(NEVER)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// The FINANCIAL CUSTOMER: whoever pays for one or more students' educational services. Owns the
/// payment plan(s), installments (via the plan), payments, credits, refunds, collections, statements
/// and agreements. Students remain the owners of their charges/discounts/scholarships/academic
/// history; the allocation engine connects the two. Additive & backward-compatible: legacy student
/// billing (payments with financialAccountId NULL) keeps working unchanged. A payer is usually the
/// primary guardian but may be a company/charity/sponsor/government/etc (ownerType).
/// HOW a Financial Account (Payer) pays over time: the account-level cadence, count and first due
/// date. It owns the account installment schedule as a coordination layer over the per-charge
/// PaymentPlans (each student charge keeps its own plan, aligned to this one via
/// PaymentPlan.financialPlanId) so a chosen "9 installments" always yields exactly 9 account
/// installments. The allocation engine still settles individual student-charge installments (BR-11,
/// ADR-001) — this never changes the ledger.
model FinancialAccountPlan {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  payerId        String             @db.Uuid // the Financial Account (Payer) this plan belongs to
  academicYearId String             @db.Uuid
  cadence        PaymentPlanCadence @default(MONTHLY)
  installments   Int
  firstDueDate   DateTime           @db.Date
  status         PaymentPlanStatus  @default(ACTIVE)
  createdById    String?            @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payer        Payer         @relation(fields: [payerId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentPlans PaymentPlan[]

  @@index([tenantId, payerId])
  @@index([tenantId, status])
}

// ----------------------------------------------------------------------------
// Communication
// ----------------------------------------------------------------------------

model Announcement {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  title         String
  body          String
  audience      AnnouncementAudience @default(ALL)
  sectionId     String?              @db.Uuid
  publishedById String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([tenantId, createdAt])
}

// A per-user item in the in-app notification center. Fanned out from announcements/events.
// `title`/`body` hold the recipient's resolved (localized) display text; the `*En`/`*Ar` fields
// retain the rendered bilingual variants for re-localization and audit.
model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  userId         String               @db.Uuid
  type           String? // event type, e.g. "StudentAbsent"
  category       NotificationCategory @default(SYSTEM)
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(PENDING)
  title          String
  body           String
  titleEn        String?
  titleAr        String?
  bodyEn         String?
  bodyAr         String?
  data           Json?
  mandatory      Boolean              @default(false)
  announcementId String?              @db.Uuid
  readAt         DateTime?            @db.Timestamptz(6)
  archivedAt     DateTime?            @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement?          @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]
  audits       NotificationAudit[]

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, category, createdAt])
}

// Per-user channel/category opt-in matrix. One row per (tenantId, userId); missing rows imply
// opt-in defaults. School-enforced (mandatory) notifications bypass this — see NotificationEngine.
model NotificationPreference {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  userId       String  @unique @db.Uuid
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)

  attendancePush    Boolean @default(true)
  attendanceEmail   Boolean @default(true)
  financePush       Boolean @default(true)
  financeEmail      Boolean @default(true)
  academicPush      Boolean @default(true)
  academicEmail     Boolean @default(true)
  behaviorPush      Boolean @default(true)
  behaviorEmail     Boolean @default(true)
  announcementPush  Boolean @default(true)
  announcementEmail Boolean @default(true)
  systemPush        Boolean @default(true)
  systemEmail       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

// Versioned, bilingual templates per (eventType, channel, language). Tenant overrides the
// built-in default; renderer falls back to the default when no active row exists.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  eventType String
  channel   NotificationChannel
  language  String // "en" | "ar"
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, channel, language])
  @@index([tenantId])
}

// One row per channel send attempt — the delivery ledger powering analytics + manual resend.
model NotificationDelivery {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  notificationId   String              @db.Uuid
  channel          NotificationChannel
  provider         String // "fcm" | "resend" | "in-app"
  status           DeliveryStatus      @default(QUEUED)
  providerResponse Json?
  attempts         Int                 @default(0)
  deliveredAt      DateTime?           @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, notificationId])
  @@index([tenantId, status])
  @@index([tenantId, channel, createdAt])
}

// Append-only audit trail per notification (created/sent/read/resend/...).
model NotificationAudit {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  notificationId String?  @db.Uuid
  action         String
  actorId        String?  @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([tenantId, notificationId])
  @@index([tenantId, createdAt])
}

// Per-tenant sender identity + global channel kill-switches. The sender email is NEVER hardcoded;
// it defaults to notification@munaxa.com and is editable from the Admin Portal.
model NotificationSettings {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @db.Uuid
  senderName   String   @default("Munaxa Notifications")
  senderEmail  String   @default("notification@munaxa.com")
  replyToEmail String   @default("support@munaxa.com")
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Single source of truth for school identity, branding, document generation, communication,
/// compliance, social presence, and advanced document defaults (Settings → Organization).
/// One row per tenant. Every optional branding/document feature has its own enable toggle; when a
/// toggle is off the corresponding asset/section is omitted from generated documents and the UI.
/// Asset columns store S3 object keys (never the binary). Structured/optional sub-configs are kept
/// in JSON columns (forward-compatible, mirrors EInvoiceSettings.templateConfig).
model OrganizationSettings {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid

  // ── General / identity ──
  nameEn          String?
  nameAr          String?
  legalName       String?
  shortName       String?
  schoolCode      String?
  ministryNumber  String?
  schoolType      OrganizationSchoolType @default(PRIVATE)
  motto           String?
  mission         String?
  vision          String?
  establishedYear Int?
  description     String?
  timezone        String                 @default("Asia/Amman")
  defaultLanguage String                 @default("en")

  // ── Contact ──
  phone            String?
  mobile           String?
  whatsapp         String?
  email            String?
  website          String?
  country          String?
  city             String?
  district         String?
  street           String?
  building         String?
  postalCode       String?
  googleMapsUrl    String?
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  emergencyContact String?
  officeHours      String?

  // ── Branding feature toggles (every feature independently enabled) ──
  logoEnabled      Boolean @default(false)
  darkLogoEnabled  Boolean @default(false)
  smallLogoEnabled Boolean @default(false)
  watermarkEnabled Boolean @default(false)
  stampEnabled     Boolean @default(false)
  signatureEnabled Boolean @default(false)

  // ── Branding assets (S3 object keys) ──
  logoKey      String?
  darkLogoKey  String?
  smallLogoKey String?
  stampKey     String?
  signatureKey String?
  bannerKey    String?

  // ── Branding structured config ──
  logoVisibility    Json? // { reports, certificates, studentCards, parentPortal, mobileApp, login }
  watermark         Json? // { source: LOGO|SCHOOL_NAME|CONFIDENTIAL, text, opacity, scale, rotation }
  stampPlacement    String @default("RIGHT") // LEFT | CENTER | RIGHT
  signaturePosition String @default("RIGHT") // LEFT | CENTER | RIGHT

  // ── Document settings ──
  headerEnabled Boolean @default(false)
  footerEnabled Boolean @default(false)
  qrEnabled     Boolean @default(false)
  documents     Json? // { headerHtml, headerAlign, footerHtml, footerAlign, logoPosition, paperSize, margins{top,bottom,left,right}, headerHeight, footerHeight, qrContent }

  // ── Communication identity ──
  senderName              String?
  senderEmail             String?
  replyToEmail            String?
  emailFooter             String?
  notificationDisplayName String?
  smsSender               String?
  whatsappDisplayName     String?
  pushIconKey             String?
  notificationImageKey    String?

  // ── Social & website ──
  socialEnabled Boolean @default(false)
  social        Json? // { website, facebook, instagram, linkedin, youtube, tiktok, x }

  // ── Academic identity ──
  curriculum         String?
  academicYearFormat String?
  colorTheme         String?

  // ── Compliance (optional) ──
  complianceEnabled      Boolean @default(false)
  commercialRegistration String?
  licenseNumber          String?
  ministryLicense        String?
  taxNumber              String?
  vatNumber              String?
  otherGovIds            Json? // [{ label, value }]

  // ── Advanced document defaults ──
  defaultReportLanguage      String  @default("en")
  defaultCertificateLanguage String  @default("en")
  documentNumberPrefix       String?
  defaultFont                String?
  defaultReportTheme         String?
  defaultLogoVariant         String  @default("PRIMARY") // PRIMARY | DARK | SMALL
  documentCompression        Boolean @default(true)
  pdfQuality                 Int     @default(90)
  imageQuality               Int     @default(85)
  storageOptimization        Boolean @default(true)

  // ── Audit ──
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  deviceType String? // free-form device label (e.g. "Pixel 8", "iPad")
  active     Boolean        @default(true)
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, active])
}

// Per-tenant feature flags (e.g. the WhatsApp bridge). Disabled by default.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Parent portal (Phase 11)
// ----------------------------------------------------------------------------

// A parent-submitted leave (planned) or absence (excuse) request for one of their children.
// Reviewed (approved/rejected) by school staff holding leave:approve.
model LeaveRequest {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  studentId     String             @db.Uuid
  requestedById String?            @db.Uuid
  type          LeaveRequestType
  status        LeaveRequestStatus @default(PENDING)
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  reason        String
  reviewedById  String?            @db.Uuid
  reviewNote    String?
  reviewedAt    DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?   @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

// A Parent-Teacher Meeting slot offered by a teacher (optionally for a specific section).
model PtmSlot {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  teacherId   String        @db.Uuid
  sectionId   String?       @db.Uuid
  startsAt    DateTime      @db.Timestamptz(6)
  endsAt      DateTime      @db.Timestamptz(6)
  location    String?
  capacity    Int           @default(1)
  status      PtmSlotStatus @default(OPEN)
  notes       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section   Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("PtmSlotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookings  PtmBooking[]

  @@index([tenantId])
  @@index([tenantId, teacherId])
  @@index([tenantId, startsAt])
}

// A parent's booking of a PTM slot for one of their children.
model PtmBooking {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  slotId     String           @db.Uuid
  studentId  String           @db.Uuid
  bookedById String?          @db.Uuid
  status     PtmBookingStatus @default(BOOKED)
  note       String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot     PtmSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bookedBy User?   @relation("PtmBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)

  @@unique([slotId, studentId])
  @@index([tenantId])
  @@index([tenantId, slotId])
  @@index([tenantId, studentId])
}

// Document vault: secure files attached to a student (report cards, certificates, medical, IDs).
