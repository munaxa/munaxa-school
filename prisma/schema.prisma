// ----------------------------------------------------------------------------
// Control plane: tenant database promotion (pool → dedicated/silo) wizard
// ----------------------------------------------------------------------------
// Tracks the super-admin-driven promotion of a school onto its own database. The actual
// connection URL/secret lives in the secrets manager (TENANT_DATABASE_OVERRIDES), never here;
// this row records intent, target reference, wizard state, and audit. Lives in the shared
// control-plane database; managed on the platform plane.
model TenantDatabase {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @unique @db.Uuid
  status        TenantDbStatus @default(REQUESTED)
  connectionRef String? // reference/key for the target DB secret (NOT the URL itself)
  hostLabel     String? // human label, e.g. "school-a / on-prem Amman"
  note          String?
  lastError     String?
  requestedById String?        @db.Uuid
  activatedAt   DateTime?      @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ----------------------------------------------------------------------------
// E-Invoicing framework (Phase 16) — provider-agnostic engine; JoFotara = provider #1.
// Per-tenant configuration lives in the DB (zero hardcoding); secrets encrypted at rest
// (AES-256-GCM, see CryptoService). All rows are tenant-scoped + RLS like every module.
// ----------------------------------------------------------------------------

enum EInvoiceEnvironment {
  SIMULATION // no real API calls — full pipeline with a locally faked PASS (JoFotara has no public sandbox)
  PRODUCTION
}

enum EInvoiceTaxpayerType {
  INCOME // not VAT-registered — invoices carry NO tax elements at all
  SALES // general sales tax (16% standard; reduced rates allowed)
  SPECIAL // special fixed tax + general tax per line
}

enum EInvoiceDocType {
  INVOICE // UBL InvoiceTypeCode 388
  CREDIT_NOTE // 381 — return; must reference the original document + reason
}

enum EInvoicePaymentKind {
  CASH // نقدي
  RECEIVABLE // ذمم — buyer info mandatory
}

enum EInvoiceDocStatus {
  DRAFT
  QUEUED
  SUBMITTING
  ACCEPTED
  REJECTED // provider validation failed — no auto-retry; fix + requeue
  DEAD_LETTER // transient retries exhausted — manual requeue
  CANCELLED
}

/// Per-tenant e-invoicing configuration + wizard state. One row per tenant.
model EInvoiceSettings {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String               @unique @db.Uuid
  provider               String               @default("jofotara") // EInvoiceProvider key
  enabled                Boolean              @default(false) // hard kill-switch (with the feature flag)
  environment            EInvoiceEnvironment  @default(SIMULATION)
  endpointUrl            String? // override; defaults to the provider's production URL
  // Step 2 — seller (school) legal info
  legalNameEn            String?
  legalNameAr            String?
  taxNumber              String? // TIN — digits only
  vatNumber              String?
  commercialRegistration String?
  addressLine            String?
  city                   String?
  countryCode            String               @default("JO")
  phone                  String?
  email                  String?
  // Step 4/5 — mapping + tax config (JSON mapping engine; schema documented in the module)
  taxpayerType           EInvoiceTaxpayerType @default(INCOME)
  vatEnabled             Boolean              @default(false)
  vatPercent             Decimal?             @db.Decimal(5, 2) // e.g. 16.00
  defaultTaxCategory     String               @default("Z") // JoFotara: Z=exempt, O=zero-rated, S=standard
  defaultPaymentKind     EInvoicePaymentKind  @default(RECEIVABLE)
  // Finance ↔ JoFotara automation (Phase 19)
  autoIssueOnCharge      Boolean              @default(false) // create+queue an invoice when a charge is raised
  autoCreditOnAdjustment Boolean              @default(false) // create+queue a 381 credit note when an invoiced charge is reduced
  fieldMappings          Json? // fee-category → item naming / overrides
  templateConfig         Json? // Step 6 — PDF/print template options (logo, header, footer, AR/EN/bilingual)
  // Wizard progress ("Save draft" / resume)
  completedSteps         Int                  @default(0) // highest completed step (0..7)
  lastTestAt             DateTime?            @db.Timestamptz(6)
  lastTestOk             Boolean?
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials EInvoiceCredential[]

  @@index([tenantId])
}

/// Device credentials (Step 3). Secret encrypted at rest (AES-256-GCM, "v1:iv:tag:data");
/// never returned to clients — masked hint only.
model EInvoiceCredential {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  settingsId           String   @db.Uuid
  clientId             String
  secretEncrypted      String // AES-256-GCM ciphertext — NEVER the plaintext
  secretHint           String // last 4 chars for display
  incomeSourceSequence String // تسلسل مصدر الدخل — the registered activity number
  deviceLabel          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings EInvoiceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([settingsId])
}

/// Gapless per-tenant ICV allocation (row-locked in the issuing transaction).
model EInvoiceCounter {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  nextIcv  BigInt @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// An e-invoice document — the engine's own record; finance rows are never mutated.
model EInvoiceDocument {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  docType            EInvoiceDocType     @default(INVOICE)
  paymentKind        EInvoicePaymentKind @default(RECEIVABLE)
  status             EInvoiceDocStatus   @default(DRAFT)
  // Identity & numbering
  invoiceNumber      String // merchant's own number (sanitised: no '/')
  uuid               String              @unique @db.Uuid // provider-side duplication key — stable across retries
  icv                BigInt? // allocated when queued; gapless per tenant
  // Finance source (one of): a Charge (receivable invoice) or a Payment (receipt).
  chargeId           String?             @db.Uuid
  paymentId          String?             @db.Uuid
  studentId          String?             @db.Uuid
  // Buyer snapshot (frozen at issue time — guardian or payer)
  buyerName          String?
  buyerIdScheme      String? // TN | NIN | PN
  buyerIdValue       String?
  buyerPhone         String?
  buyerCity          String?
  // Credit notes
  originalDocumentId String?             @db.Uuid
  creditReason       String?
  // Money snapshot (JOD, 3dp)
  currency           String              @default("JOD")
  taxExclusive       Decimal             @db.Decimal(12, 3)
  taxAmount          Decimal             @default(0) @db.Decimal(12, 3)
  discountTotal      Decimal             @default(0) @db.Decimal(12, 3)
  payableAmount      Decimal             @db.Decimal(12, 3)
  lines              Json // [{ name, quantity, unitPrice, discount, taxCategory, taxPercent, taxAmount, lineTotal }]
  // Submission artefacts (ISTD 4-year retention)
  submittedXml       String? // exact UBL XML submitted (base64-decoded form)
  signedInvoice      String? // provider-returned signed invoice (base64)
  qrCode             String? // provider-returned QR string — rendered on the printed invoice
  providerUuid       String? // provider-side uuid echo
  validationResults  Json? // full PASS/ERROR payload from the provider
  lastError          String?
  attempts           Int                 @default(0)
  nextAttemptAt      DateTime?           @db.Timestamptz(6)
  issuedAt           DateTime?           @db.Timestamptz(6)
  acceptedAt         DateTime?           @db.Timestamptz(6)
  createdById        String?             @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge      Charge?            @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  payment     Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  student     Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  original    EInvoiceDocument?  @relation("CreditNoteOriginal", fields: [originalDocumentId], references: [id], onDelete: SetNull)
  creditNotes EInvoiceDocument[] @relation("CreditNoteOriginal")
  logs        EInvoiceLog[]

  @@unique([tenantId, invoiceNumber, docType])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt]) // worker claim scan
}

/// Immutable audit trail of every transition & submission (who/when/what).
model EInvoiceLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  documentId  String   @db.Uuid
  event       String // CREATED | QUEUED | SUBMITTED | ACCEPTED | REJECTED | RETRY_SCHEDULED | DEAD_LETTER | REQUEUED | CANCELLED | TEST_CONNECTION
  detail      Json?
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document EInvoiceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, createdAt])
}

// ----------------------------------------------------------------------------
// Student billing ledger (Phase 17) — extends the AR sub-ledger with structured
// deductions, payment→charge allocation, and refunds/credit. Charges (debits) and
// Transactions (payments) already exist; these add the missing traceability.
// Account totals stay sum-based (back-compat); allocations add per-charge precision.
// ----------------------------------------------------------------------------

enum AdjustmentType {
  SCHOLARSHIP // need-/merit-based reduction
  DISCOUNT // general discount
  SIBLING_DISCOUNT
  STAFF_DISCOUNT
  WAIVER // partial/full waive of a specific charge (granted discount)
  WRITE_OFF // bad debt written off (distinct from a granted waiver) — ADR-007
  CREDIT_MEMO // account-level credit not tied to a charge
  CORRECTION // fixes a billing error
}

enum AdjustmentStatus {
  APPLIED
  REVERSED
}

enum RefundStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// The provenance of a Credit asset lot (CR-1).
enum CreditSource {
  OVERPAYMENT // residual verified payment after all installments settled (AR-5)
  CREDIT_MEMO // account-level CREDIT_MEMO adjustment
  SCHOLARSHIP // scholarship converted to account credit
  RETURN // returned goods/services
}

/// A deduction/correction against a charge's net (chargeId set) or the account (chargeId null,
/// CREDIT_MEMO → grants a Credit). Types: discount/scholarship/waiver/write-off/correction/
/// credit-memo (BR-26..30).
model FeeAdjustment {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  accountId    String           @db.Uuid
  studentId    String           @db.Uuid
  chargeId     String?          @db.Uuid // null = account-level credit memo
  type         AdjustmentType
  amount       Decimal          @db.Decimal(12, 3) // resolved reduction value (JOD)
  percent      Decimal?         @db.Decimal(5, 2) // if set, amount was computed from the charge net
  reason       String
  status       AdjustmentStatus @default(APPLIED)
  createdById  String?          @db.Uuid
  reversedById String?          @db.Uuid
  reversedAt   DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charge  Charge?                 @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  credit  Credit? // set when this adjustment granted a credit lot

  @@index([tenantId, accountId])
  @@index([tenantId, studentId])
  @@index([tenantId, chargeId])
  @@index([tenantId, status])
}

/// Applies (part of) a verified payment to a specific INSTALLMENT. reversedAt null = active
/// (AR-1, BR-22). Allocation never targets a charge directly.
model PaymentAllocation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  paymentId     String    @db.Uuid
  installmentId String    @db.Uuid
  amount        Decimal   @db.Decimal(12, 3)
  createdById   String?   @db.Uuid
  reversedAt    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentId])
  @@index([tenantId, installmentId])
}

/// An independent asset lot the account holds (over-payment, credit-memo, …), with provenance
/// and a derived remaining balance. Refunds and future credit-applications draw it down (CR-1..5).
model Credit {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  accountId    String       @db.Uuid
  // The Financial Account (Payer) that holds this credit. For an account over-payment the balance is
  // owned by the payer across all its students; a student's own credit shares the same payer.
  payerId      String?      @db.Uuid
  source       CreditSource
  amount       Decimal      @db.Decimal(12, 3)
  adjustmentId String?      @unique @db.Uuid // provenance when granted by a CREDIT_MEMO
  paymentId    String?      @db.Uuid // provenance when from an over-payment
  reason       String?
  expiresAt    DateTime?    @db.Date
  createdById  String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payer        Payer?                  @relation(fields: [payerId], references: [id], onDelete: SetNull)
  adjustment   FeeAdjustment?          @relation(fields: [adjustmentId], references: [id], onDelete: SetNull)
  payment      Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  consumptions RefundConsumption[]

  @@index([tenantId, accountId])
  @@index([tenantId, payerId])
}

/// A refund of available credit back to the payer. Consumes specific Credit lots FIFO. Same
/// verify workflow as a payment (BR-33..35, CR-2).
model Refund {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  accountId    String        @db.Uuid
  studentId    String        @db.Uuid
  payerId      String?       @db.Uuid // the Financial Account refunded
  amount       Decimal       @db.Decimal(12, 3)
  method       PaymentMethod
  reference    String?
  reason       String
  status       RefundStatus  @default(PENDING)
  recordedById String?       @db.Uuid
  verifiedById String?       @db.Uuid
  verifiedAt   DateTime?     @db.Timestamptz(6)
  note         String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      StudentFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payer        Payer?                  @relation(fields: [payerId], references: [id], onDelete: SetNull)
  consumptions RefundConsumption[]

  @@index([tenantId, accountId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

/// A single Credit lot drawn by a Refund (FIFO). Σ consumptions == refund.amount (BR-34).
model RefundConsumption {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  refundId  String   @db.Uuid
  creditId  String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([tenantId, refundId])
  @@index([tenantId, creditId])
}

// ----------------------------------------------------------------------------
// Collections & Dunning — the dunning workflow over an account's OVERDUE installments.
//   CollectionsCase (aggregate root) + PromiseToPay + DunningEvent; StudentBillingProfile
//   is a cached projection of the headline status + permanent flags (BR-40..42, ADR-010).
//   Students in LEGAL are excluded from automated reminders.
// ----------------------------------------------------------------------------

/// Cached headline collections status on the profile projection (NONE until a case opens).
enum CollectionsStatus {
  NONE
  FINANCIAL_ISSUE // watch: has an open collections case
  LEGAL // escalated to the lawyer — excluded from automated reminders
}

/// Workflow status of a CollectionsCase (§3.7).
enum CollectionsCaseStatus {
  OPEN
  PROMISE_TO_PAY
  LEGAL
  RESOLVED
}

/// Type of a recorded dunning event within a case.
enum DunningEventType {
  REMINDER // an automated/manual late-payment reminder was sent
  NOTE // a manual collection note
  STATUS_CHANGE // the case status changed
  PROMISE // a promise-to-pay was recorded
  ESCALATION // escalated to legal/lawyer
  COMMUNICATION // a logged parent contact (call/WhatsApp/meeting/…)
}

/// How a finance officer contacted the parent, for the Communication Log (additive; nullable
/// on DunningEvent — only set on COMMUNICATION events).
enum CommunicationMedium {
  PHONE
  WHATSAPP
  SMS
  EMAIL
  MEETING
  NOTE
}

/// Escalation level of a late-payment reminder (additive; nullable on DunningEvent — set on
/// REMINDER events). Encourages a gentle→firm progression before any plan change.
enum ReminderLevel {
  FRIENDLY
  OVERDUE
  FINAL
  TRANSPORT_WARNING
  SUSPENSION_NOTICE
}

enum ReminderChannel {
  IN_APP
  SMS
  PUSH
  EMAIL
}

/// The dunning workflow over a FINANCIAL ACCOUNT's overdue installments: status, promises, events,
/// lawyer ref (ADR-010). Owned by the account (Payer) — one case per account, shared by all its
/// students, so collections (reminders / promises / legal) happen at the account level and a student
/// only references the account's status. `accountId` is a legacy per-student fallback key for
/// accounts that have no payer yet (kept for backward compatibility); new cases key on `payerId`.
model CollectionsCase {
  id         String                @id @default(uuid()) @db.Uuid
  tenantId   String                @db.Uuid
  payerId    String?               @unique @db.Uuid // the Financial Account (preferred owner)
  accountId  String?               @unique @db.Uuid // legacy per-student key (no-payer fallback)
  status     CollectionsCaseStatus @default(OPEN)
  lawyerRef  String?
  notes      String?
  openedById String?               @db.Uuid
  openedAt   DateTime              @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime?             @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @db.Timestamptz(6)

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payer    Payer?                   @relation(fields: [payerId], references: [id], onDelete: Cascade)
  account  StudentFinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  promises PromiseToPay[]
  events   DunningEvent[]

  @@index([tenantId, status])
}

/// A recorded commitment (amount + date) within a collections case (BR: PromiseToPay).
model PromiseToPay {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  caseId      String   @db.Uuid
  amount      Decimal  @db.Decimal(12, 3)
  promiseBy   DateTime @db.Date
  kept        Boolean? // null = open, true = kept, false = broken
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   CollectionsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId, caseId])
}

/// Append-only log of a dunning action (reminder/note/status change/promise/escalation).
/// Reminder events also snapshot the outstanding/overdue amounts at send time.
model DunningEvent {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  caseId         String               @db.Uuid
  type           DunningEventType
  channels       ReminderChannel[]
  /// Contact medium — only set on COMMUNICATION events (the Communication Log).
  medium         CommunicationMedium?
  /// Escalation level — only set on REMINDER events (friendly → suspension notice).
  level          ReminderLevel?
  outstanding    Decimal?             @db.Decimal(12, 3)
  dueThisMonth   Decimal?             @db.Decimal(12, 3)
  overdue        Decimal?             @db.Decimal(12, 3)
  recipientCount Int                  @default(0)
  smsSentCount   Int                  @default(0)
  detail         String?
  actorId        String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   CollectionsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId, caseId])
  @@index([tenantId, createdAt])
}

/// One per student: cached collections headline + permanent financial flags + reminder cadence
/// bookkeeping. Single-writer projection (Collections/Admissions) — never a money source (§4).
model StudentBillingProfile {
  id                       String            @id @default(uuid()) @db.Uuid
  tenantId                 String            @db.Uuid
  studentId                String            @unique @db.Uuid
  collectionsStatus        CollectionsStatus @default(NONE)
  legalNote                String?
  flaggedById              String?           @db.Uuid
  flaggedAt                DateTime?         @db.Timestamptz(6)
  lastReminderAt           DateTime?         @db.Timestamptz(6)
  /// Transport service suspended for non-payment (BillingPolicy.suspendTransportAfterOverdue).
  /// Persisted state so boarding/transport flows can consult it; auto-restored when caught up.
  transportSuspended       Boolean           @default(false)
  transportSuspendedAt     DateTime?         @db.Timestamptz(6)
  /// Why/who/when for the current or last transport suspension (additive — audit-friendly display).
  transportSuspendedReason String?
  transportSuspendedById   String?           @db.Uuid
  transportReinstatedAt    DateTime?         @db.Timestamptz(6)
  /// Set true when this student's fees deviate from the standard school plan (registrar override),
  /// driving the permanent "Fee Modified" badge. customArrangement marks a bespoke schedule.
  feeModified              Boolean           @default(false)
  customArrangement        Boolean           @default(false)
  financialNote            String?
  createdAt                DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, collectionsStatus])
}

// ----------------------------------------------------------------------------
// Campus Presence + Transportation (Phase 21) — NEW domains, fully additive.
// Separate from Academic Attendance (StudentAttendance/TeacherAttendance), which is unchanged.
// Append-only events; idempotent replay via @@unique([tenantId, clientRef]).
// ----------------------------------------------------------------------------

enum PresenceEventType {
  GATE_IN
  GATE_OUT
  RECEPTION_CHECKIN
  RECEPTION_CHECKOUT
}

enum PresenceMethod {
  NFC
  RFID
  QR
  MANUAL
  FACE
  BUS
}

enum BusEventType {
  BOARD_AM
  ARRIVE_SCHOOL
  BOARD_PM
  ARRIVE_HOME
}

enum TransportMethod {
  NFC
  RFID
  QR
  MANUAL
}

/// Per-tenant attendance-source configuration: whether arrival events auto-create PRESENT,
/// plus presence/transport feature toggles and the default bus capture method.
enum AttendanceSourceMode {
  TEACHER_ONLY
  GATE_ARRIVAL
  BUS_ARRIVAL
  HYBRID
}

/// Physical campus presence (gate / reception). NOT academic attendance.
model StudentPresenceEvent {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  studentId  String            @db.Uuid
  eventType  PresenceEventType
  method     PresenceMethod    @default(MANUAL)
  occurredAt DateTime          @db.Timestamptz(6)
  deviceId   String?
  /// Client-generated id from the offline queue — idempotent replay key.
  clientRef  String?
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientRef])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, occurredAt])
}

/// Transportation boarding/arrival events. NOT academic attendance; references the existing Bus.
model BusAttendanceEvent {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  studentId  String          @db.Uuid
  busId      String          @db.Uuid
  eventType  BusEventType
  method     TransportMethod @default(NFC)
  occurredAt DateTime        @db.Timestamptz(6)
  clientRef  String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientRef])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, busId])
  @@index([tenantId, occurredAt])
}

model AttendanceSourceConfig {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @unique @db.Uuid
  mode             AttendanceSourceMode @default(TEACHER_ONLY)
  busMethod        TransportMethod      @default(NFC)
  presenceEnabled  Boolean              @default(false)
  transportEnabled Boolean              @default(false)
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Student card registry (Phase 22) — NFC/RFID cards issued to students, with lifecycle.
// NFC/RFID identification resolves a card UID → studentId only when the card is ACTIVE.
// ----------------------------------------------------------------------------

enum CardType {
  NFC
  RFID
}

enum CardStatus {
  ACTIVE
  SUSPENDED
  STOLEN
  LOST
  REVOKED
}

model StudentCard {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  studentId  String     @db.Uuid
  cardUid    String // the physical card/tag UID
  type       CardType   @default(NFC)
  status     CardStatus @default(ACTIVE)
  label      String?
  issuedById String?    @db.Uuid
  issuedAt   DateTime   @default(now()) @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cardUid])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

/// Governmental/school vaccination record for a student: which vaccine, the grade at which it
/// was administered, and whether it was actually received.
model StudentVaccine {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  studentId String    @db.Uuid
  name      String // vaccine name (e.g. "MMR", "Polio")
  grade     String? // grade at which it was given (e.g. "Grade 1", "KG")
  received  Boolean   @default(true) // whether the governmental vaccine was received
  dateGiven DateTime? @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
}

// ============================================================================
// Enrollment & Billing — Configuration layer (Phase 1)
// Additive, tenant-scoped fee/discount/transport/policy configuration that the
// enrollment orchestration (later phases) reads to compute quotes. The Charge/
// Transaction/PaymentAllocation/FeeAdjustment ledger remains the money system of
// record; these tables only describe *how* fees are derived.
// ============================================================================

enum DiscountType {
  FULL_PAYMENT
  SIBLING
  SCHOLARSHIP
  PROMOTIONAL
  MANUAL
}

enum DiscountCalc {
  FIXED
  PERCENT
}

enum TransportDirection {
  NONE
  ONE_WAY
  TWO_WAY
}

/// Per-grade, per-academic-year registration + annual tuition fees, with effective
/// dating so historical versions are preserved (never edited in place — supersede).
model GradeFeeSchedule {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  gradeId         String    @db.Uuid
  academicYearId  String    @db.Uuid
  registrationFee Decimal   @db.Decimal(12, 3) // JOD
  tuitionFee      Decimal   @db.Decimal(12, 3) // JOD, annual
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  isActive        Boolean   @default(true)
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId, academicYearId, gradeId])
  @@index([tenantId, isActive])
}

/// Per-academic-year transportation fares by direction. Independent of tuition.
model TransportFare {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  academicYearId String   @db.Uuid
  routeId        String?  @db.Uuid // shared fleet route (source of truth for identity)
  amount         Decimal  @db.Decimal(12, 3) // JOD, annual — the two-way (round trip) total
  oneWayPct      Decimal  @default(100) @db.Decimal(5, 2) // one-way price as a % of the total
  isActive       Boolean  @default(true)
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  route        BusRoute?    @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, academicYearId, routeId])
  @@index([tenantId, academicYearId])
  @@index([routeId])
}

/// Configurable discount rules. Applications are recorded as FeeAdjustment rows
/// (reused) when a rule is applied during enrollment/billing.
model DiscountRule {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  name               String
  type               DiscountType
  calc               DiscountCalc
  value              Decimal      @db.Decimal(12, 3) // percent (0-100) or fixed JOD
  maxAmount          Decimal?     @db.Decimal(12, 3) // cap for percentage discounts
  appliesToTransport Boolean      @default(false) // most discounts exclude transport
  startDate          DateTime?    @db.Date
  endDate            DateTime?    @db.Date
  isActive           Boolean      @default(true)
  createdById        String?      @db.Uuid
  updatedById        String?      @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, type])
}

/// One tenant-level billing policy (installment bounds, full-payment discount,
/// transport suspension threshold). Singleton per tenant.
model BillingPolicy {
  id                                  String   @id @default(uuid()) @db.Uuid
  tenantId                            String   @unique @db.Uuid
  minInstallments                     Int      @default(1)
  maxInstallments                     Int      @default(9)
  fullPaymentDiscountPct              Decimal  @default(0) @db.Decimal(5, 2) // e.g. 5.00 = 5%
  earlyRegistrationDiscountPct        Decimal  @default(0) @db.Decimal(5, 2)
  /// When true, registrar fee modifications need FinanceOfficer approval before the
  /// enrollment/billing/invoices can be activated (FeeModificationApproval workflow).
  requireFinanceApprovalForFeeChanges Boolean  @default(false)
  /// When false (default), the user who applies a fee modification cannot approve it —
  /// approval requires a different user (separation of duties). Set true for small teams
  /// where the same person registers and approves.
  allowSelfFeeApproval                Boolean  @default(false)
  suspendTransportAfterOverdue        Int      @default(2) // # overdue installments
  /// Optional alternative thresholds (additive): suspend once the oldest overdue installment is
  /// older than N days, or once the overdue amount exceeds this. Any satisfied threshold suspends.
  suspendTransportAfterDays           Int? // days the oldest overdue is aged
  suspendTransportAfterAmount         Decimal? @db.Decimal(12, 3) // overdue amount (JOD)
  createdById                         String?  @db.Uuid
  updatedById                         String?  @db.Uuid
  createdAt                           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                           DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Admissions: registration, re-enrollment, quotation & payment planning (Phase 22).
// Built on top of the existing finance/billing/fee-config layer — never duplicates the
// ledger (Charge/Transaction/PaymentAllocation) or the discount engine (DiscountRule/
// FeeAdjustment). Quotes are persisted (student-less until commit); a registration commit
// creates Student+Parent+Enrollment+Charges atomically; every fee override is tracked.
// ----------------------------------------------------------------------------

enum FeeItemKind {
  REGISTRATION
  TUITION
  BOOKS
  UNIFORM
  INSURANCE
  ACTIVITY
  TECHNOLOGY
  EXAM
  LABORATORY
  TRANSPORT
  CUSTOM
}

// The ADMISSION WORKFLOW status (Decision 2). Distinct concept from EnrollmentStatus: it tracks how a
// person moves through admission, not their participation in a year. Lives on the admission artifact
// (the Enrollment row created during admission; Draft/Quoted are quote-level pre-enrollment states).
enum AdmissionStatus {
  DRAFT
  QUOTED
  ACCEPTED // e.g. held pending finance approval of a fee modification
  REGISTERED // admission finalised — the enrollment is active
  CANCELLED // admission abandoned before registration (Cancel Admission)
}

// PARTICIPATION status of an Enrollment within one Academic Year (Decision 2). Distinct from the
// admission workflow above. The legacy values (QUOTED/PENDING_APPROVAL/COMMITTED) are retained only
// for the transition — new code writes ACTIVE + the terminal participation states; the workflow is
// tracked by AdmissionStatus. Legacy values are removed in the Phase-B cleanup.
enum EnrollmentStatus {
  // Participation states (target model).
  ACTIVE
  COMPLETED
  PROMOTED
  REPEATED
  WITHDRAWN
  GRADUATED
  ARCHIVED
  // Legacy admission-workflow values (transition only; superseded by AdmissionStatus).
  QUOTED
  PENDING_APPROVAL
  COMMITTED
  CANCELLED
}

enum QuotePaymentMode {
  FULL
  INSTALLMENTS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Catalog of fee types a school can charge (mandatory + optional). Registration/Tuition/
/// Transport are seeded as canonical kinds; schools add their own CUSTOM items.
model FeeItem {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  kind         FeeItemKind @default(CUSTOM)
  nameEn       String
  nameAr       String
  mandatory    Boolean     @default(false)
  discountable Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdById  String?     @db.Uuid
  updatedById  String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeFees GradeFeeItem[]
  charges   Charge[]

  @@index([tenantId, isActive])
  @@index([tenantId, kind])
}

/// Per-grade, per-academic-year amount for a FeeItem, effective-dated (never edited in place —
/// supersede). mandatory/discountable here override the catalog defaults.
model GradeFeeItem {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  feeItemId      String    @db.Uuid
  gradeId        String    @db.Uuid
  academicYearId String    @db.Uuid
  amount         Decimal   @db.Decimal(12, 3) // JOD
  mandatory      Boolean   @default(false)
  discountable   Boolean   @default(false)
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeItem      FeeItem      @relation(fields: [feeItemId], references: [id], onDelete: Cascade)
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId, academicYearId, gradeId])
  @@index([tenantId, isActive])
}

/// A persisted fee quotation. Created BEFORE a student exists (studentId null until commit),
/// so a parent can shop a quote without committing. Snapshots the totals + payment plan.
model EnrollmentQuote {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  academicYearId      String             @db.Uuid
  gradeId             String             @db.Uuid
  studentId           String?            @db.Uuid
  transportDirection  TransportDirection @default(NONE)
  paymentMode         QuotePaymentMode   @default(INSTALLMENTS)
  installments        Int                @default(1)
  firstDueDate        DateTime?          @db.Date
  totalFees           Decimal            @db.Decimal(12, 3)
  discountEligible    Decimal            @db.Decimal(12, 3)
  discountAmount      Decimal            @db.Decimal(12, 3)
  nonDiscountEligible Decimal            @db.Decimal(12, 3)
  grandTotal          Decimal            @db.Decimal(12, 3)
  feeModified         Boolean            @default(false)
  createdById         String?            @db.Uuid
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade        Grade                 @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  student      Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  items        EnrollmentQuoteItem[]
  enrollment   Enrollment?

  @@index([tenantId, academicYearId])
  @@index([tenantId, studentId])
}

/// A single fee line of a quote. Captures the discountable flag + any registrar override.
model EnrollmentQuoteItem {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  quoteId        String      @db.Uuid
  feeItemId      String?     @db.Uuid
  kind           FeeItemKind
  label          String
  amount         Decimal     @db.Decimal(12, 3)
  discountable   Boolean     @default(false)
  discountAmount Decimal     @default(0) @db.Decimal(12, 3)
  overridden     Boolean     @default(false)
  originalAmount Decimal?    @db.Decimal(12, 3)
  overrideReason String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  EnrollmentQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
}

/// Per-academic-year enrollment record. Distinguishes years and powers re-enrollment;
/// the financial detail lives in the existing ledger (Charge/installment plan).
model Enrollment {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  studentId           String             @db.Uuid
  academicYearId      String             @db.Uuid
  gradeId             String             @db.Uuid
  sectionId           String?            @db.Uuid
  // Year-scoped placement (Decisions 4 & 13): everything that varies between Academic Years lives on
  // the Enrollment, never on Student. `campusId` is the campus the student attends this year;
  // classroom/section are their room/homeroom. All nullable/additive — backfilled from the year/student.
  campusId            String?            @db.Uuid
  classroomId         String?            @db.Uuid
  // Year-scoped transport intent (moved off Student; Fleet remains the operational source of truth).
  areaId              String?            @db.Uuid
  transportRequested  Boolean            @default(false)
  // Lifecycle dates for this participation.
  admissionDate       DateTime?          @db.Date
  withdrawalDate      DateTime?          @db.Date
  graduationDate      DateTime?          @db.Date
  // Free-text reason for a terminal transition (withdraw/graduate/cancel).
  reason              String?
  quoteId             String?            @unique @db.Uuid
  transportDirection  TransportDirection @default(NONE)
  // Two distinct concepts (Decision 2): `admissionStatus` = how the person moved through admission;
  // `status` = participation in the academic year. New code drives decisions off `admissionStatus`
  // (REGISTERED = finalised) and sets `status = ACTIVE` on registration; year-end/withdrawal move
  // `status` to the terminal participation states.
  admissionStatus     AdmissionStatus    @default(REGISTERED)
  status              EnrollmentStatus   @default(ACTIVE)
  paymentMode         QuotePaymentMode   @default(INSTALLMENTS)
  feeModified         Boolean            @default(false)
  // Whether the one-time registration fee was paid at registration (the usual case). When true it is
  // billed as its own one-off charge; when false it is folded into the monthly installment plan.
  registrationFeePaid Boolean            @default(true)
  createdById         String?            @db.Uuid
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade                  Grade                   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  section                Section?                @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  campus                 Campus?                 @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classroom              Classroom?              @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  area                   Area?                   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  quote                  EnrollmentQuote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  modifications          FeeModification[]
  arrangements           FinancialArrangement[]
  commitment             RegistrationCommitment?
  registrationAgreements RegistrationAgreement[]

  @@unique([tenantId, studentId, academicYearId])
  @@index([tenantId, academicYearId, gradeId])
  @@index([tenantId, status])
  @@index([tenantId, admissionStatus])
  @@index([tenantId, sectionId])
  @@index([tenantId, campusId])
}

/// Mandatory tracking of every deviation from the standard school fee plan. Append-only.
model FeeModification {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  enrollmentId  String?  @db.Uuid
  studentId     String?  @db.Uuid
  field         String
  originalValue String
  newValue      String
  difference    String
  reason        String
  modifiedById  String?  @db.Uuid
  modifiedAt    DateTime @default(now()) @db.Timestamptz(6)

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment Enrollment?              @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  approval   FeeModificationApproval?

  @@index([tenantId, enrollmentId])
  @@index([tenantId, studentId])
}

/// Finance approval of a fee modification (when BillingPolicy.requireFinanceApprovalForFeeChanges).
model FeeModificationApproval {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  modificationId String         @unique @db.Uuid
  status         ApprovalStatus @default(PENDING)
  approverId     String?        @db.Uuid
  note           String?
  decidedAt      DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modification FeeModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// A special/custom financial arrangement (bespoke schedule, negotiated terms).
model FinancialArrangement {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  studentId    String   @db.Uuid
  enrollmentId String?  @db.Uuid
  description  String
  schedule     Json?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
}

/// Idempotent record of a completed registration commit (prevents double student creation).
model RegistrationCommitment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  enrollmentId   String   @unique @db.Uuid
  studentId      String   @db.Uuid
  idempotencyKey String
  receiptRef     String?
  committedById  String?  @db.Uuid
  committedAt    DateTime @default(now()) @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, committedAt])
}

// ----------------------------------------------------------------------------
// Year-End Processing (Decisions 9 & 10)
//   A controlled, resumable, preview→confirm workflow. NOTHING (no Enrollment,
//   Charge, PaymentPlan or finance record) is created until Final Confirm; until
//   then everything lives as draft YearEndDecision rows and is fully reversible.
//   On commit, promote/repeat go through the shared enrollment pipeline (a new
//   Enrollment in the next year — history is never modified), and graduate/
//   withdraw go through the EnrollmentLifecycleService.
// ----------------------------------------------------------------------------

enum YearEndProcessStatus {
  OPEN // decisions are being drafted/reviewed — no enrollments created yet
  COMMITTED // Final Confirm pressed — decisions have been applied
  CANCELLED // draft abandoned before commit
}

/// The per-student action chosen in the Year-End review board. DECIDE_LATER is the default so the
/// system NEVER silently promotes (Decision 9).
enum YearEndAction {
  PROMOTE
  REPEAT
  GRADUATE
  WITHDRAW
  DECIDE_LATER
}

/// One Year-End run for a School: from the closing (source) Academic Year into the next (target) one.
model YearEndProcess {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @db.Uuid
  schoolId             String               @db.Uuid
  sourceAcademicYearId String               @db.Uuid
  targetAcademicYearId String               @db.Uuid
  status               YearEndProcessStatus @default(OPEN)
  createdById          String?              @db.Uuid
  committedById        String?              @db.Uuid
  committedAt          DateTime?            @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions YearEndDecision[]

  @@index([tenantId, status])
  @@index([tenantId, schoolId, sourceAcademicYearId])
}

/// A draft, per-student decision within a YearEndProcess. Holds the chosen action + the
/// administrator-assigned target placement (grade/section/classroom are NEVER auto-copied — Decision
/// 10). `resultingEnrollmentId` is set only after Final Confirm creates the next enrollment. Student /
/// enrollment / grade / section / classroom are plain references (no FK relations) to avoid coupling.
model YearEndDecision {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @db.Uuid
  processId             String        @db.Uuid
  studentId             String        @db.Uuid
  sourceEnrollmentId    String        @db.Uuid
  action                YearEndAction @default(DECIDE_LATER)
  targetGradeId         String?       @db.Uuid
  targetSectionId       String?       @db.Uuid
  targetClassroomId     String?       @db.Uuid
  reason                String?
  // Highlighted for manual review (failed subjects / missing grades / administrative or finance holds).
  needsReview           Boolean       @default(false)
  reviewNote            String?
  resultingEnrollmentId String?       @db.Uuid
  committedAt           DateTime?     @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  process YearEndProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([processId, studentId])
  @@index([tenantId, processId])
}

// ----------------------------------------------------------------------------
// Enterprise Document Engine (Phase 23)
//   Reusable engine that generates every official school document (admissions
//   agreements + finance documents) from a permanent JSON snapshot, stores the
//   rendered PDF immutably, and archives + audits every generation/print/email.
//   Consumes the existing ledger/admissions/organization data; never duplicates
//   any financial record.
// ----------------------------------------------------------------------------

/// The catalog of official documents the engine can produce. New types are added here
/// and given a template in the document module — no schema change needed per layout.
enum DocumentType {
  REGISTRATION_AGREEMENT
  PAYMENT_RECEIPT
  ANNUAL_TUITION_CERTIFICATE
  OUTSTANDING_BALANCE_CERTIFICATE
  CLEARANCE_CERTIFICATE
  ACCOUNT_STATEMENT
  PAYMENT_HISTORY
  FEE_BREAKDOWN
  STUDENT_FINANCIAL_SUMMARY
}

/// Document rendering language. BILINGUAL renders Arabic + English side-by-side.
enum DocumentLanguage {
  EN
  AR
  BILINGUAL
}

/// Lifecycle of an archived document. A document is immutable once ARCHIVED; a newer
/// version of the same logical document SUPERSEDES it (the old PDF is retained).
enum GeneratedDocumentStatus {
  ARCHIVED
  SUPERSEDED
  CANCELLED
}

/// Lifecycle of a registration agreement (a legal commitment, never overwritten). A single agreement
/// exists per enrollment: it is GENERATED at commit, PRINTED once handed to the parent, SIGNED once
/// the countersigned copy is uploaded, or CANCELLED/ARCHIVED administratively. DRAFT/COMMITTED are
/// retained for backward compatibility with rows created before agreement versioning was removed.
enum RegistrationAgreementStatus {
  DRAFT
  COMMITTED
  GENERATED
  PRINTED
  SIGNED
  CANCELLED
  ARCHIVED
}

/// Persistence strategy for a document type (Phase 23b). SNAPSHOT = legal record: the rendered PDF
/// is stored immutably and reprints serve the stored bytes. DYNAMIC = operational report: only
/// metadata is stored; the PDF is rendered on demand from live ledger data and discarded after.
enum DocumentPersistence {
  SNAPSHOT
  DYNAMIC
}

/// An action recorded against a document for the access history (Phase 23b).
enum DocumentAccessAction {
  GENERATE
  PRINT
  DOWNLOAD
  EMAIL
  VIEW
}

/// Outcome of a document access action.
enum DocumentAccessStatus {
  SUCCESS
  FAILED
}

/// Gapless, per-tenant, per-scope counter (one row per tenant+scope). Mirrors the
/// PaymentReceiptCounter/EInvoiceCounter pattern so document/agreement numbers are
/// sequential with no gaps or duplicates. `scope` is e.g. "AGREEMENT" or "DOC:PAYMENT_RECEIPT".
model DocumentSequence {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  scope    String
  nextNo   Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope])
}

/// An archived official document record (Phase 23 + 23b). For SNAPSHOT documents (legal records) the
/// rendered PDF is stored in `pdf` (bytea) so reprints serve the exact stored snapshot. For DYNAMIC
/// documents (operational reports) `pdf`/`checksum`/`byteSize` are NULL — only metadata is kept and
/// the PDF is re-rendered on demand from live ledger data (using `params`) and discarded. `params`
/// captures the inputs needed to re-render a DYNAMIC document; `dataSnapshot` captures the data a
/// SNAPSHOT PDF was built from. Tenant-scoped (RLS); every action is recorded in DocumentAccessLog.
model GeneratedDocument {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  documentNo  Int // gapless per tenant+type
  type        DocumentType
  persistence DocumentPersistence     @default(SNAPSHOT)
  title       String
  language    DocumentLanguage        @default(EN)
  status      GeneratedDocumentStatus @default(ARCHIVED)
  version     Int                     @default(1)

  // Optional subjects/links (all SetNull so the archive survives record deletion).
  studentId      String? @db.Uuid
  parentId       String? @db.Uuid
  academicYearId String? @db.Uuid
  enrollmentId   String? @db.Uuid
  paymentId      String? @db.Uuid

  // SNAPSHOT: the immutable data + rendered artifact. DYNAMIC: these are NULL.
  dataSnapshot Json?
  pdf          Bytes?
  checksum     String? // sha256 hex of the stored PDF (SNAPSHOT only)
  byteSize     Int?
  // DYNAMIC: the inputs needed to re-render the PDF on demand from live data.
  params       Json?

  // Access counters (denormalised cache of DocumentAccessLog for fast listing/UI).
  printedCount       Int       @default(0)
  downloadCount      Int       @default(0)
  emailCount         Int       @default(0)
  lastPrintedAt      DateTime? @db.Timestamptz(6)
  lastDownloadedAt   DateTime? @db.Timestamptz(6)
  lastEmailedAt      DateTime? @db.Timestamptz(6)
  lastPrintedById    String?   @db.Uuid
  lastDownloadedById String?   @db.Uuid
  lastEmailedById    String?   @db.Uuid
  generatedById      String?   @db.Uuid
  generatedAt        DateTime  @default(now()) @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student?               @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parent       Parent?                @relation(fields: [parentId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  agreement    RegistrationAgreement?
  accessLogs   DocumentAccessLog[]
  emailLogs    DocumentEmailLog[]

  @@unique([tenantId, type, documentNo])
  @@index([tenantId, type])
  @@index([tenantId, studentId])
  @@index([tenantId, generatedAt])
}

/// Complete per-action access history for a document (Phase 23b): generation, print, download,
/// email and view events, with the actor and request context. The counters on GeneratedDocument are
/// a denormalised cache of these rows. Tenant-scoped (RLS); each row mirrors an AuditLog entry.
model DocumentAccessLog {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  documentId   String               @db.Uuid
  documentType DocumentType
  action       DocumentAccessAction
  status       DocumentAccessStatus @default(SUCCESS)
  actorUserId  String?              @db.Uuid
  ip           String?
  userAgent    String?
  device       String?
  detail       String?
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, createdAt])
  @@index([tenantId, action])
}

/// Email-delivery history for a document (Phase 23b) — metadata only; the PDF attachment is never
/// stored (re-attached from the snapshot or re-rendered for dynamic docs). Tenant-scoped (RLS).
model DocumentEmailLog {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @db.Uuid
  documentId       String               @db.Uuid
  sentById         String?              @db.Uuid
  recipients       String[]
  cc               String[]
  bcc              String[]
  subject          String?
  providerResponse String?
  status           DocumentAccessStatus @default(SUCCESS)
  retryCount       Int                  @default(0)
  sentAt           DateTime             @default(now()) @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId, sentAt])
}

/// A registration agreement — the legal commitment between the school and the parent, created
/// automatically right after a successful registration commit, from a permanent financial snapshot.
/// Exactly ONE agreement exists per enrollment and it is immutable: it captures what the parent
/// agreed to at registration and is never regenerated from later financial changes (those live in
/// the billing ledger). The generated PDF lives on the linked GeneratedDocument; the parent's
/// countersigned copy is uploaded to object storage and referenced by `signedFileKey` (never stored
/// in the database). `version`/`supersedesId` are deprecated (retained for backward compatibility;
/// always 1) — agreements are no longer versioned.
model RegistrationAgreement {
  id          String                      @id @default(uuid()) @db.Uuid
  tenantId    String                      @db.Uuid
  agreementNo Int // gapless per tenant
  version     Int                         @default(1) // deprecated — always 1 (no versioning)
  // DB default stays COMMITTED (a pre-existing enum value) so the additive migration never has to
  // reference a newly-added label; the repository sets GENERATED explicitly on every new agreement.
  status      RegistrationAgreementStatus @default(COMMITTED)

  enrollmentId   String  @db.Uuid
  studentId      String  @db.Uuid
  parentId       String? @db.Uuid
  academicYearId String  @db.Uuid
  campusId       String? @db.Uuid
  gradeId        String? @db.Uuid
  sectionId      String? @db.Uuid

  registrationDate    DateTime         @db.Date
  paymentMode         QuotePaymentMode @default(INSTALLMENTS)
  installments        Int              @default(1)
  // Permanent financial snapshot at commit time (fee lines, discounts, schedule).
  feeBreakdown        Json
  installmentSchedule Json
  grandTotal          Decimal          @db.Decimal(12, 3)

  // The archived PDF document (the stored, reprintable snapshot).
  documentId   String? @unique @db.Uuid
  supersedesId String? @db.Uuid // deprecated (no versioning) — retained for backward compatibility

  // The parent's countersigned copy — a reference into object storage (S3), never stored inline.
  signedFileKey      String? // tenant-scoped storage key (tenants/<tenantId>/agreements-signed/…)
  signedFileName     String?
  signedFileType     String? // application/pdf | image/jpeg | image/png
  signedFileSize     Int?
  // Inline fallback: when object storage (S3) is NOT configured, the countersigned copy is stored
  // here (bytea) so the upload/view flow works without cloud credentials. When S3 IS configured this
  // stays NULL and the file lives in the bucket, referenced by signedFileKey.
  signedFileData     Bytes?
  signedAt           DateTime? @db.Date // the date the parent signed (as recorded by staff)
  signedBy           String? // name of the signatory (the parent), recorded by staff
  signedUploadedById String?   @db.Uuid // staff user who uploaded the signed copy
  signedUploadedAt   DateTime? @db.Timestamptz(6)

  registrarId String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment   Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent       Parent?                 @relation(fields: [parentId], references: [id], onDelete: SetNull)
  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  document     GeneratedDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  supersedes   RegistrationAgreement?  @relation("AgreementVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy RegistrationAgreement[] @relation("AgreementVersions")

  @@unique([tenantId, agreementNo])
  @@unique([tenantId, enrollmentId, version])
  @@index([tenantId, studentId])
  @@index([tenantId, enrollmentId])
}

/// Why a student's billing responsibility (legal payer) was transferred (PR #212 review).
enum BillingResponsibilityReason {
  PARENT_REQUEST
  COURT_ORDER
  SECRETARY_CORRECTION
  DUPLICATE_ADMISSION_CORRECTION
  OTHER
}

/// Immutable business record of a billing-responsibility transfer — the dedicated financial event
/// behind changing the legal payer of a StudentFinancialAccount. Easier to report on than scanning
/// AuditLog, and preserves the full payer history for a student. Scalar tenant scoping (RLS in the
/// migration); no Prisma relations so no other model needs a back-relation.
model BillingResponsibilityTransfer {
  id                        String                      @id @default(uuid()) @db.Uuid
  tenantId                  String                      @db.Uuid
  studentFinancialAccountId String                      @db.Uuid
  studentId                 String                      @db.Uuid
  fromPayerId               String?                     @db.Uuid
  toPayerId                 String                      @db.Uuid
  reason                    BillingResponsibilityReason
  notes                     String?
  performedById             String?                     @db.Uuid
  performedAt               DateTime                    @default(now()) @db.Timestamptz(6)

  @@index([tenantId])
  @@index([tenantId, studentFinancialAccountId])
  @@index([tenantId, studentId])
}

// ----------------------------------------------------------------------------
// SaaS Subscription & Platform Billing (Phase 24)
//
// Munaxa is a multi-tenant School OS sold as SaaS. These models describe the
// commercial plane: which plan a school is on, what it may use, how much of its
// quota it has consumed, and the workflow the Platform Console (Munaxa employees)
// uses to review upgrade requests and override features per-tenant.
//
// Plan/Feature/Coupon rows are GLOBAL (no tenantId) — one catalog shared by all
// tenants; only platform sessions may write them. Everything else is tenant-scoped
// (RLS in the migration): a school reads its own subscription/usage/billing, the
// platform plane reads and writes across all tenants.
//
// IMPORTANT: Core School OS modules (Admissions, Students, Attendance, Finance,
// Academics, Parent Portal, Student App, Timetable, Communication, Reporting) are
// NEVER gated by a plan. Plans only control limits, integrations, AI, automation,
// branding, storage, API, and enterprise capabilities.
// ----------------------------------------------------------------------------

/// The three commercial tiers. A plan's tier is its stable identity across renames.
enum PlanTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

/// How a subscription is billed. TRIAL is a time-boxed evaluation with no charge.
enum BillingCycle {
  MONTHLY
  YEARLY
  TRIAL
}

/// Lifecycle of a school's subscription. GRACE_PERIOD follows a missed renewal before
/// suspension; SUSPENDED locks upgrades/writes to paid capabilities but never core modules.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  // READ_ONLY: the school can log in and view data, but all create/update/delete is blocked and
  // upgrade prompts remain available (v2). A soft-suspension short of losing access.
  READ_ONLY
  SUSPENDED
  CANCELLED
  EXPIRED
  // ARCHIVED: terminal, retained for history/analytics; not billable, not loginable as a customer.
  ARCHIVED
}

/// Upgrade-request workflow: a school requests, the platform reviews and decides.
enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Coupon discount shape.
enum CouponType {
  PERCENT
  FIXED
}

/// How long a coupon's discount applies once redeemed.
enum CouponDuration {
  ONCE
  REPEATING
  FOREVER
}

/// Payment provider behind a school's billing. Manual/offline are supported today;
/// STRIPE and MYFATOORAH are wired for future online billing.
enum PaymentProvider {
  MANUAL
  OFFLINE
  STRIPE
  MYFATOORAH
}

/// A subscription plan (global catalog). Limits are columns (null = unlimited);
/// boolean capabilities live in {@link SubscriptionFeature} rows. Core modules are
/// implicit and never represented here.
model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  tier         PlanTier @unique
  name         String
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  // LEGACY pricing (minor units). v2 moves pricing to {@link PriceBook} (multi-currency /
  // per-country / time-boxed). These columns are retained as the default-currency fallback so
  // existing subscriptions and callers keep working unchanged. Null price = "contact sales".
  priceMonthly Int?
  priceYearly  Int?
  currency     String   @default("JOD")
  // Quota limits. NULL means UNLIMITED for that dimension.
  maxCampuses  Int?
  maxStudents  Int?
  maxStaff     Int?
  storageGb    Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  features            SubscriptionFeature[]
  subscriptions       TenantSubscription[]
  trials              Trial[]
  upgradeRequestsTo   UpgradeRequest[]      @relation("UpgradeRequestTo")
  upgradeRequestsFrom UpgradeRequest[]      @relation("UpgradeRequestFrom")
  planChangesTo       PlanChangeHistory[]   @relation("PlanChangeTo")
  planChangesFrom     PlanChangeHistory[]   @relation("PlanChangeFrom")
  priceBooks          PriceBook[]
  planVersions        PlanVersion[]

  @@index([isActive])
}

/// A boolean capability entitlement for a plan (e.g. api, ai_assistant, sso, white_label,
/// jofotara, advanced_reports, custom_integrations, dedicated_support, enterprise_security,
/// enterprise_ai, automation, branding). Absence of a row = disabled.
model SubscriptionFeature {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  key       String
  enabled   Boolean  @default(true)
  // Optional numeric entitlement for metered capabilities (e.g. api rate). Null = not metered.
  limit     Int?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
}

/// The single active subscription for a tenant. Renewal = currentPeriodEnd.
model TenantSubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime           @default(now()) @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @db.Timestamptz(6)
  trialEndsAt        DateTime?          @db.Timestamptz(6)
  graceEndsAt        DateTime?          @db.Timestamptz(6)
  cancelledAt        DateTime?          @db.Timestamptz(6)
  couponId           String?            @db.Uuid
  // v2: the plan VERSION this subscription was purchased on (NULL = latest/unversioned; existing
  // subscriptions are unaffected). Customers stay on their version until migrated.
  planVersionId      String?            @db.Uuid
  startedAt          DateTime           @default(now()) @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  coupon      Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  planVersion PlanVersion?     @relation(fields: [planVersionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([planId])
  @@index([currentPeriodEnd])
}

/// A current usage counter for a tenant against one metered dimension
/// (students, campuses, staff, storage_gb, api_calls). One row per metric.
model SubscriptionUsage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  metric    String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric])
  @@index([tenantId])
}

/// Immutable history of plan/status changes for a tenant (who, when, why).
model PlanChangeHistory {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  fromPlanId       String?  @db.Uuid
  toPlanId         String   @db.Uuid
  fromStatus       String?
  toStatus         String?
  fromCycle        String?
  toCycle          String?
  reason           String?
  upgradeRequestId String?  @db.Uuid
  changedById      String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromPlan SubscriptionPlan? @relation("PlanChangeFrom", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlan   SubscriptionPlan  @relation("PlanChangeTo", fields: [toPlanId], references: [id])

  @@index([tenantId, createdAt])
}

/// Billing identity + payment routing for a tenant.
model BillingProfile {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @unique @db.Uuid
  legalName          String?
  taxId              String?
  billingEmail       String?
  billingPhone       String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  country            String?
  provider           PaymentProvider @default(MANUAL)
  externalCustomerId String?
  notes              String?
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Discount coupon (global catalog).
model Coupon {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique
  description    String?
  type           CouponType
  // PERCENT: percentOff (0-100). FIXED: amountOff in minor currency units.
  percentOff     Int?
  amountOff      Int?
  currency       String?
  duration       CouponDuration @default(ONCE)
  durationMonths Int?
  appliesToTier  PlanTier?
  maxRedemptions Int?
  timesRedeemed  Int            @default(0)
  validFrom      DateTime?      @db.Timestamptz(6)
  validUntil     DateTime?      @db.Timestamptz(6)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  subscriptions TenantSubscription[]

  @@index([isActive])
}

/// A time-boxed evaluation for a tenant (usually of the Professional plan).
model Trial {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @unique @db.Uuid
  planId        String    @db.Uuid
  startedAt     DateTime  @default(now()) @db.Timestamptz(6)
  endsAt        DateTime  @db.Timestamptz(6)
  convertedAt   DateTime? @db.Timestamptz(6)
  expiredAt     DateTime? @db.Timestamptz(6)
  extendedCount Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([endsAt])
}

/// A school-initiated request to change plan/cycle. Schools cannot self-serve plan
/// changes — the Platform Console reviews and applies the change, which takes effect
/// immediately (no deployment).
model UpgradeRequest {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  fromPlanId      String?              @db.Uuid
  requestedPlanId String               @db.Uuid
  requestedCycle  BillingCycle?
  status          UpgradeRequestStatus @default(PENDING)
  note            String?
  requestedById   String?              @db.Uuid
  reviewedById    String?              @db.Uuid
  reviewedAt      DateTime?            @db.Timestamptz(6)
  decisionNote    String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromPlan      SubscriptionPlan? @relation("UpgradeRequestFrom", fields: [fromPlanId], references: [id], onDelete: SetNull)
  requestedPlan SubscriptionPlan  @relation("UpgradeRequestTo", fields: [requestedPlanId], references: [id])

  @@index([tenantId, status])
  @@index([status, createdAt])
}

/// A per-tenant override of a single feature or limit, without minting a custom plan.
/// enabled overrides a boolean capability; limitOverride raises/lowers a numeric limit.
/// Optional expiresAt supports temporary beta access. Every change is audited.
model TenantFeatureOverride {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  key           String
  enabled       Boolean?
  limitOverride Int?
  reason        String?
  expiresAt     DateTime? @db.Timestamptz(6)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ----------------------------------------------------------------------------
// Platform Console v2 — Enterprise SaaS enhancements (Phase 25)
//
// All ADDITIVE. Existing tenants/subscriptions keep working unchanged:
//   - Pricing moves to PriceBook (multi-currency / per-country / time-boxed); the legacy
//     SubscriptionPlan price columns remain as the default-currency fallback.
//   - Organizations group schools (nullable Tenant.organizationId; NULL = standalone).
//   - PlanVersion preserves purchased limits/pricing; FeatureCatalog replaces hard-coded keys.
//   - Billing is its own domain (Munaxa → school), distinct from school finance (school → parent).
//   - Webhooks fan out subscription/billing lifecycle events to external integrations.
//
// Naming avoids collisions with the school-finance domain (Payment/Refund/PaymentMethod there
// are school→parent) by prefixing platform billing models with `Billing`.
// ----------------------------------------------------------------------------

/// A school group. Enterprise customers manage multiple schools (tenants) under one organization.
/// Platform-plane (cross-tenant): readable by any bound session, writable only by the platform.
model Organization {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  slug                String    @unique
  billingEmail        String?
  countryCode         String?
  // Consolidated billing (future): when true, invoices roll up to the organization.
  consolidatedBilling Boolean   @default(false)
  // Archived organizations are retained for history but hidden from the active list; their schools
  // are detached (organizationId set null) on archive, so standalone behavior is unaffected.
  isArchived          Boolean   @default(false)
  archivedAt          DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  tenants Tenant[]

  @@index([slug])
  @@index([isArchived])
}

/// Multi-currency / per-country / time-boxed pricing for a plan (global catalog). One plan may
/// have many price books; the effective one is resolved by currency + country + date, preferring
/// the most specific, active, `isDefault` row. Supports future promotional pricing via effectiveTo.
model PriceBook {
  id            String    @id @default(uuid()) @db.Uuid
  planId        String    @db.Uuid
  currency      String
  countryCode   String? // NULL = applies to any country in this currency
  monthlyPrice  Int? // minor units; NULL = "contact sales"
  yearlyPrice   Int?
  setupFee      Int       @default(0)
  effectiveFrom DateTime  @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime? @db.Timestamptz(6)
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, currency, countryCode])
  @@index([planId, isActive])
}

/// An immutable snapshot of a plan's entitlements + pricing at a point in time. Plans are never
/// edited in place: publishing a change creates a new version. Existing customers stay on their
/// purchased version (TenantSubscription.planVersionId); new customers get the current one.
model PlanVersion {
  id           String   @id @default(uuid()) @db.Uuid
  planId       String   @db.Uuid
  version      Int
  isCurrent    Boolean  @default(false)
  // Frozen snapshot of limits + capability codes + pricing at publish time.
  limits       Json
  featureCodes String[]
  pricing      Json?
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  plan          SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions TenantSubscription[]

  @@unique([planId, version])
  @@index([planId, isCurrent])
}

/// The catalog of platform capabilities (replaces hard-coded feature keys). Plans reference these
/// codes. Core School OS modules are `isCore = true` and permanently enabled (never gated).
model FeatureCatalog {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  description      String?
  category         String   @default("general")
  isCore           Boolean  @default(false)
  defaultEnabled   Boolean  @default(false)
  enterpriseOnly   Boolean  @default(false)
  requiresApproval Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@index([category])
}

/// Status of a platform billing invoice (Munaxa → school).
enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  REFUNDED
}

/// Status of a platform billing payment.
enum BillingPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// Delivery status of a webhook attempt.
enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DISABLED
}

/// A platform invoice raised against a school (tenant-scoped; platform reads all).
model BillingInvoice {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  number      String
  status      BillingInvoiceStatus @default(DRAFT)
  currency    String               @default("JOD")
  subtotal    Int                  @default(0)
  taxAmount   Int                  @default(0)
  total       Int                  @default(0)
  periodStart DateTime?            @db.Timestamptz(6)
  periodEnd   DateTime?            @db.Timestamptz(6)
  dueDate     DateTime?            @db.Timestamptz(6)
  issuedAt    DateTime?            @db.Timestamptz(6)
  paidAt      DateTime?            @db.Timestamptz(6)
  notes       String?
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    BillingInvoiceLine[]
  payments BillingPayment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([status, dueDate])
}

/// A line on a platform invoice.
model BillingInvoiceLine {
  id          String @id @default(uuid()) @db.Uuid
  invoiceId   String @db.Uuid
  description String
  quantity    Int    @default(1)
  unitAmount  Int    @default(0)
  amount      Int    @default(0)

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// A payment recorded against a school's platform billing.
model BillingPayment {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  invoiceId     String?              @db.Uuid
  provider      PaymentProvider      @default(MANUAL)
  amount        Int
  currency      String               @default("JOD")
  status        BillingPaymentStatus @default(PENDING)
  externalRef   String?
  failureReason String?
  paidAt        DateTime?            @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refunds BillingRefund[]

  @@index([tenantId, status])
  @@index([status])
}

/// A refund against a platform payment. Scalar tenant scoping (RLS); no Tenant back-relation.
model BillingRefund {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  paymentId String               @db.Uuid
  amount    Int
  reason    String?
  status    BillingPaymentStatus @default(COMPLETED)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)

  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
}

/// A stored payment method for a school's platform billing (tokenized reference only).
model BillingPaymentMethod {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  provider    PaymentProvider @default(MANUAL)
  brand       String?
  last4       String?
  expMonth    Int?
  expYear     Int?
  externalRef String?
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A billing contact for a school (who receives invoices/receipts).
model BillingContact {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  email     String
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Tax rate by country for platform billing (global catalog).
model BillingTaxRate {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String
  name        String
  // Rate in basis points (e.g. 1600 = 16%).
  rateBps     Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([countryCode, name])
  @@index([countryCode, isActive])
}

/// An outbound webhook endpoint. tenantId NULL = a platform-global integration (CRM/accounting/
/// analytics); non-null = a school-specific endpoint.
model WebhookEndpoint {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  url         String
  description String?
  // Subscribed event types (e.g. "subscription.created"); empty = all events.
  eventTypes  String[]
  secret      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@index([isActive])
}

/// One delivery attempt of an event to an endpoint (the event log + retry bookkeeping).
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  endpointId     String                @db.Uuid
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?             @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
  @@index([eventType, createdAt])
}

// ============================================================================
// Attendance evolution program — Shift (N1), Policy (N2), Lock (N3),
// Correction workflow (N4), Biometric ingestion (N5).
// All HR-owned (Employee aggregate). See CAPABILITY_OWNERSHIP_MATRIX.md.
// ============================================================================

enum ShiftKind {
  MORNING
  EVENING
  SPLIT
  FLEXIBLE
  WEEKEND
  CUSTOM
}

enum AttendanceLockScope {
  DAY
  WEEK
  PAYROLL
  SEMESTER
}

enum AttendanceLockStatus {
  ACTIVE
  RELEASED
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

enum AttendanceCorrectionDecision {
  APPROVED
  REJECTED
}

enum BiometricPunchDirection {
  IN
  OUT
}

/// Configurable attendance thresholds (N2). Data-driven: nothing hardcoded. One row per tenant may
/// be flagged `isDefault`; a campus-scoped row overrides it for that campus.
model AttendancePolicy {
  id                           String   @id @default(uuid()) @db.Uuid
  tenantId                     String   @db.Uuid
  campusId                     String?  @db.Uuid
  name                         String
  isDefault                    Boolean  @default(false)
  graceMinutes                 Int      @default(5)
  lateAfterMinutes             Int      @default(1)
  absentAfterMinutes           Int      @default(240)
  halfDayAfterShortfallMinutes Int      @default(180)
  earlyDepartureAfterMinutes   Int      @default(15)
  overtimeAfterMinutes         Int      @default(30)
  countWeekendAsWorking        Boolean  @default(false)
  allowManualOverride          Boolean  @default(true)
  isActive                     Boolean  @default(true)
  createdAt                    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, campusId])
}

/// A configured work window (N1): expected check-in/out, unpaid break and an optional credited-hours
/// cap. Thresholds live in the linked AttendancePolicy — never duplicated here.
model Shift {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  campusId         String?   @db.Uuid
  policyId         String?   @db.Uuid
  name             String
  kind             ShiftKind @default(MORNING)
  /// "HH:MM" 24h, local school time (same frame as the timetable).
  expectedCheckIn  String
  expectedCheckOut String
  breakMinutes     Int       @default(0)
  maxHours         Decimal?  @db.Decimal(4, 2)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus?                   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  policy      AttendancePolicy?         @relation(fields: [policyId], references: [id], onDelete: SetNull)
  assignments EmployeeShiftAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, campusId])
}

/// Assignment of a shift to an employee over an effective window. `daysOfWeek` empty ⇒ every day the
/// calendar treats as working.
model EmployeeShiftAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  employeeId    String      @db.Uuid
  shiftId       String      @db.Uuid
  effectiveFrom DateTime    @db.Date
  effectiveTo   DateTime?   @db.Date
  daysOfWeek    DayOfWeek[]
  createdById   String?     @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("ShiftAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, shiftId])
}

/// An immutability window over staff attendance (N3). While ACTIVE, writes covering any date in
/// [periodStart, periodEnd] are rejected; corrections must go through the correction workflow.
model AttendanceLock {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  campusId     String?              @db.Uuid
  scope        AttendanceLockScope
  periodStart  DateTime             @db.Date
  periodEnd    DateTime             @db.Date
  status       AttendanceLockStatus @default(ACTIVE)
  reason       String?
  lockedById   String?              @db.Uuid
  lockedAt     DateTime             @default(now()) @db.Timestamptz(6)
  releasedById String?              @db.Uuid
  releasedAt   DateTime?            @db.Timestamptz(6)
  releaseNote  String?
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus     Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)
  lockedBy   User?   @relation("AttendanceLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  releasedBy User?   @relation("AttendanceLockReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status, periodStart, periodEnd])
  @@index([tenantId, campusId, status])
}

/// Enterprise correction workflow (N4): request → review → approval → apply. Nothing is edited
/// in place by the requester; the approved change is applied through the canonical write path and
/// the original values are retained here as immutable history.
model AttendanceCorrectionRequest {
  id                  String                     @id @default(uuid()) @db.Uuid
  tenantId            String                     @db.Uuid
  employeeId          String                     @db.Uuid
  date                DateTime                   @db.Date
  requestedStatus     StaffAttendanceStatus
  requestedCheckInAt  DateTime?                  @db.Timestamptz(6)
  requestedCheckOutAt DateTime?                  @db.Timestamptz(6)
  requestedNote       String?
  /// Status observed when the request was raised (immutable record of what was corrected from).
  previousStatus      StaffAttendanceStatus?
  reason              String
  evidenceUrl         String?
  status              AttendanceCorrectionStatus @default(PENDING)
  currentLevel        Int                        @default(1)
  requiredLevels      Int                        @default(1)
  requestedById       String?                    @db.Uuid
  appliedAt           DateTime?                  @db.Timestamptz(6)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)

  tenant      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee                       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy User?                          @relation("AttendanceCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvals   AttendanceCorrectionApproval[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId, date])
}

/// One decision in a correction's approval chain (mirrors the proven staff-leave approval trail).
model AttendanceCorrectionApproval {
  id          String                       @id @default(uuid()) @db.Uuid
  tenantId    String                       @db.Uuid
  requestId   String                       @db.Uuid
  level       Int
  decision    AttendanceCorrectionDecision
  note        String?
  decidedById String?                      @db.Uuid
  decidedAt   DateTime                     @default(now()) @db.Timestamptz(6)

  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request   AttendanceCorrectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decidedBy User?                       @relation("AttendanceCorrectionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([requestId, level])
  @@index([tenantId])
}

/// Normalised device punch (N5). Providers write here first (idempotent on the provider's own
/// reference), then the ingestion service folds punches into StaffAttendance through the canonical
/// record() path. Keeps a durable audit of what a device actually reported.
model BiometricRawPunch {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  employeeId      String?                 @db.Uuid
  providerKey     String
  externalRef     String
  deviceId        String?
  punchAt         DateTime                @db.Timestamptz(6)
  direction       BiometricPunchDirection
  /// Employee identifier as reported by the device, before resolution (badge no, finger id, ...).
  externalUserRef String?
  rawPayload      Json?
  processedAt     DateTime?               @db.Timestamptz(6)
  processingError String?
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([tenantId, providerKey, externalRef])
  @@index([tenantId, punchAt])
  @@index([tenantId, employeeId, punchAt])
  @@index([tenantId, processedAt])
}
