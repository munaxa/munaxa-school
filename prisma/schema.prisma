// ============================================================================
// Munaxa — Prisma schema
// Phase 2: Core Database Design.
//
// Multi-tenant model: shared PostgreSQL, shared schema. Every business entity
// carries a non-null `tenantId`. Isolation is enforced in depth (see
// docs/architecture/03-multi-tenant-architecture.md and the RLS migration):
//   1. JWT tenant claim (Phase 3)         3. Prisma client extension (tenant scoping)
//   2. Tenant guard (Phase 3)             4. PostgreSQL Row-Level Security (this phase)
//
// Conventions:
//   - UUID primary keys (@db.Uuid), app-generated.
//   - timestamptz timestamps (createdAt/updatedAt); soft delete via deletedAt
//     on recoverable business records.
//   - Tenant-scoped uniqueness (e.g. @@unique([tenantId, ...])).
//   - Composite indexes lead with tenantId.
//   - Bilingual fields use *_En / *_Ar pairs.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: a NON-superuser, NOBYPASSRLS role so Row-Level Security
  // is enforced on the application (see the RLS migration).
  url       = env("DATABASE_URL")
  // Migrations/introspection connect as the schema owner (privileged). Falls back
  // to DATABASE_URL when unset (e.g. simple local setups).
  directUrl = env("DIRECT_DATABASE_URL")
}

