// --- Bus tracking -----------------------------------------------------------
/// Geographic area master data (e.g. Khalda, Dabouq). The transportation department
/// maps each area to the route that serves it (Area → Route) so registration can resolve
/// the route automatically. Fleet remains the operational source of truth (routes/
/// assignments); billing still flows through TransportFare — transportFee is an optional
/// per-area override only.
model Area {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @db.Uuid
  name                    String
  routeId                 String?   @db.Uuid // the route that serves this area (Area → Route)
  academicYearId          String?   @db.Uuid // which year this route mapping reflects (optional)
  transportFee            Decimal?  @db.Decimal(12, 3) // optional fee override; default is the route's TransportFare
  transportationAvailable Boolean   @default(true) // surfaced as a choice in registration
  active                  Boolean   @default(true)
  notes                   String?
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime? @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route        BusRoute?     @relation(fields: [routeId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  students     Student[]
  enrollments  Enrollment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([routeId])
}

model BusRoute {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  academicYearId String?   @db.Uuid // groups routes by academic year (e.g. 2026/2027)
  name           String
  description    String?
  round1Time     String? // 1st trip time, "HH:MM"
  round2Time     String? // 2nd trip time, "HH:MM"
  disabledAt     DateTime? @db.Timestamptz(6) // when set, the route is disabled (still listed, shown as disabled)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  buses          Bus[]
  stops          BusStop[]
  assignments    StudentBusAssignment[]
  transportFares TransportFare[]
  serviceAreas   Area[]

  @@index([tenantId])
  @@index([tenantId, academicYearId])
}

model Bus {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  routeId     String?   @db.Uuid
  plateNumber String
  label       String?
  capacity    Int?
  tripRound   Int? // which trip of the route this bus serves: 1 (1st) or 2 (2nd)
  // HR Phase 3: the driver is now a canonical Employee (with a DriverProfile), not a free-text
  // name/phone. The old driverName/driverPhone strings were migrated into Employee records.
  driverId    String?   @db.Uuid
