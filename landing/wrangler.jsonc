{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // MUST match the Cloudflare Worker this app deploys to, and must NOT be `munaxa`: that Worker
  // (the one munaxa.com is attached to) now serves the corporate site from munaxa/munaxa. Two
  // repositories deploying to one Worker overwrite each other's site on every merge.
  // A name with no existing Worker does not fail: wrangler creates a new Worker with no custom
  // domain, which is what this one is until a domain is attached to it.
  "name": "munaxa-school-landing",
  "main": ".open-next/worker.js",
  // Keep in sync with the date this config was last reviewed.
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Non-secret runtime config. Secrets (RESEND_API_KEY) must be set via `wrangler secret put`
  // — never add secrets here.
  "vars": {
    // Public URL of the standalone Munaxa demo app's "Request a Demo" form (fallback link).
    "NEXT_PUBLIC_DEMO_URL": "https://demo.munaxa.com/request-demo",
    // Email senders for the Contact-us flow. EMAIL_FROM = visitor welcome/acknowledgment sender;
    // EMAIL_CONTACT_FROM = internal notification sender (reaches info@munaxa.com). Both addresses
    // must be on a domain verified in Resend. RESEND_API_KEY must be set via `wrangler secret put`.
    "EMAIL_FROM": "Munaxa <no-reply@mail.munaxa.com>",
    "EMAIL_CONTACT_FROM": "Munaxa Contact <contactus@mail.munaxa.com>",
  },
}
