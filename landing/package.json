{
  "name": "@school/landing",
  "version": "0.1.0",
  "private": true,
  "description": "Munaxa — the School Operating System. Marketing landing site (Next.js 15, App Router). Workspace member consuming the shared @axa/platform.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\" && exit 0",
    "cf:deps": "pnpm turbo run build --filter=@axa/platform",
    "cf:build": "pnpm run cf:deps && opennextjs-cloudflare build && node ../scripts/cf-emit-root-wrangler.mjs",
    "cf:preview": "pnpm run cf:build && wrangler dev",
    "cf:deploy": "pnpm run cf:build && wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@axa/platform": "workspace:*",
    "next": "15.1.12",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "15.1.12",
    "@opennextjs/cloudflare": "~1.16.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "wrangler": "^4.59.2"
  }
}
