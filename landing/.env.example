# ============================================================================
# Munaxa Landing — environment example. Copy to .env.local (dev) or configure as
# environment variables / Worker secrets in your hosting platform (production).
# NEVER commit a real .env file. NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

NODE_ENV=development

# Public site URL — used for canonical URLs, sitemap, robots, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://www.munaxa.com

# --- Demo app ---
# Public URL of the standalone Munaxa demo app's "Request a Demo" form (the munaxademo app,
# deployed separately). The landing "Book a demo" buttons link here.
NEXT_PUBLIC_DEMO_URL=https://demo.munaxa.com/request-demo

# --- Email (Resend) — powers the Contact-us form ---
# Sends the visitor acknowledgment (welcome) email and the internal notification to
# info@munaxa.com. If RESEND_API_KEY is unset, emails are skipped (and logged) — so the
# form still succeeds in local dev, but NO email is delivered.
#
# IMPORTANT (production): set RESEND_API_KEY as a Worker secret on the landing worker:
#   wrangler secret put RESEND_API_KEY
# The EMAIL_FROM / EMAIL_CONTACT_FROM sender domains MUST be verified in Resend. The
# deployed values live in wrangler.jsonc `vars` (mail.munaxa.com); override here for dev.
RESEND_API_KEY=
EMAIL_FROM="Munaxa <no-reply@munaxa.com>"
EMAIL_CONTACT_FROM="Munaxa Contact <contactus@munaxa.com>"
